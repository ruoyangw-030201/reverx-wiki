const __vite__css = "/* 谱系页面主容器：控制整体右移、宽度和本页色彩变量。 */\n.spectrum-classification {\n  --character-profile-blue: #234d7b;\n  --character-profile-blue-deep: #17395f;\n  --character-profile-gold: rgba(200, 155, 90, 0.86);\n  --character-profile-gold-soft: rgba(224, 194, 143, 0.42);\n  --character-profile-paper: rgba(251, 250, 246, 0.68);\n  --spectrum-line: rgba(174, 119, 55, 0.74);\n  --spectrum-line-strong: rgba(174, 119, 55, 0.96);\n  --spectrum-page-shift: clamp(48px, 5vw, 96px);\n  --spectrum-page-edge: clamp(12px, 2vw, 28px);\n  position: relative;\n  z-index: 8;\n  width: calc(100% - var(--spectrum-page-shift) - var(--spectrum-page-edge));\n  margin-top: 34px;\n  margin-left: var(--spectrum-page-shift);\n  color: var(--color-ink);\n}\n\n/* 移动端概览最终规则：统一覆盖旧的纵向假树逻辑，使用 SVG 树作为唯一连线来源。 */\n@media (max-width: 980px) {\n  /* 移动端主容器：跟随 archive 内容宽度，不在右侧额外扣宽。 */\n  .spectrum-classification {\n    width: 100%;\n    max-width: 100%;\n    margin-left: 0;\n    margin-right: 0;\n  }\n\n  /* 移动端面板：overview、说明框和 full spectrum 都吃满本页内容宽度。 */\n  .spectrum-overview-panel,\n  .spectrum-overview-note,\n  .spectrum-tree-panel {\n    width: 100%;\n    max-width: 100%;\n  }\n\n  /* 移动端 overview 画布：给下移后的卡片和 SVG 留出完整高度。 */\n  .spectrum-overview-map {\n    display: block;\n    min-height: 178px;\n    padding: 0;\n  }\n\n  /* 移动端 overview 树：取消旧的左侧 border 假树。 */\n  .spectrum-overview-tree {\n    --spectrum-overview-tree-shift: 0px;\n    --spectrum-overview-card-width: clamp(132px, 19vw, 152px);\n    position: relative;\n    display: block;\n    width: 100%;\n    min-height: 178px;\n    margin: 0 auto;\n    padding-left: 0;\n    border-left: 0;\n    transform: none;\n  }\n\n  /* 移动端 overview 横排 SVG：620px 以上显示三卡横排树。 */\n  .spectrum-overview-connector.is-inline {\n    display: block;\n    height: 132px;\n  }\n\n  /* 移动端 overview 双排 SVG：620px 以上隐藏。 */\n  .spectrum-overview-connector.is-stacked {\n    display: none;\n  }\n\n  /* 移动端 overview 圆点层：与当前 SVG 高度一致。 */\n  .spectrum-overview-dot-layer {\n    display: block;\n    height: 132px;\n  }\n\n  /* 移动端 overview 根卡和类别卡：统一宽度。 */\n  .spectrum-overview-root,\n  .spectrum-overview-node {\n    width: min(100%, var(--spectrum-overview-card-width));\n    max-width: none;\n    justify-self: center;\n  }\n\n  /* 移动端 overview 根卡：居中摆放。 */\n  .spectrum-overview-root {\n    position: relative;\n    z-index: 3;\n    margin: 0 auto;\n  }\n\n  /* 移动端 overview 伪线：全部由 SVG 接管。 */\n  .spectrum-overview-root::before,\n  .spectrum-overview-node::before {\n    content: none;\n  }\n\n  /* 移动端 overview 类别区：三列横排，整体下移对齐 SVG 端点。 */\n  .spectrum-overview-classes {\n    position: relative;\n    z-index: 3;\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    align-items: start;\n    gap: 6px;\n    width: 100%;\n    margin-top: 68px;\n  }\n\n  /* 移动端 overview 卡片：固定成小树卡片尺寸。 */\n  .spectrum-overview-tree .spectrum-card {\n    --spectrum-card-icon-size: clamp(28px, 5.2vw, 36px);\n    min-height: 44px;\n    padding: 6px 7px;\n    gap: 5px;\n    grid-template-columns: var(--spectrum-card-icon-size) minmax(0, 1fr);\n  }\n\n  /* 移动端 overview 标题：单行显示，不再把标题挤成两行。 */\n  .spectrum-overview-tree .spectrum-card-title,\n  .spectrum-card.is-overview .spectrum-card-title {\n    font-size: clamp(13px, 3.1vw, 16px);\n    white-space: nowrap;\n    overflow-wrap: normal;\n    word-break: keep-all;\n  }\n\n  /* 移动端 full spectrum：谱系卡与大类卡同宽。 */\n  .spectrum-tree-lineages,\n  .spectrum-lineage-row {\n    width: 100%;\n  }\n}\n\n/* 手机概览最终规则：三卡横排放不下时切换为 2x3 SVG 树。 */\n@media (max-width: 620px) {\n  /* 手机 overview 画布：双排树需要更高 panel。 */\n  .spectrum-overview-map,\n  .spectrum-overview-tree {\n    --spectrum-overview-card-width: 118px;\n    min-height: 238px;\n  }\n\n  /* 手机 overview SVG：隐藏横排树，显示 2x3 树。 */\n  .spectrum-overview-connector.is-inline {\n    display: none;\n  }\n\n  /* 手机 overview 2x3 SVG：左上、右上、中下三节点。 */\n  .spectrum-overview-connector.is-stacked {\n    display: block;\n    height: 220px;\n  }\n\n  /* 手机 overview 圆点层：匹配 2x3 SVG 高度。 */\n  .spectrum-overview-dot-layer {\n    height: 220px;\n  }\n\n  /* 手机 overview 类别区：两列双排，信息类居中落在第二行。 */\n  .spectrum-overview-classes {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    grid-template-rows: auto auto;\n    row-gap: 16px;\n    column-gap: 6px;\n    margin-top: 72px;\n  }\n\n  /* 手机 overview 本源类：左上。 */\n  .spectrum-overview-node.is-essence {\n    grid-column: 1;\n    grid-row: 1;\n  }\n\n  /* 手机 overview 现实类：右上。 */\n  .spectrum-overview-node.is-reality {\n    grid-column: 2;\n    grid-row: 1;\n  }\n\n  /* 手机 overview 信息类：中下。 */\n  .spectrum-overview-node.is-information {\n    grid-column: 1 / -1;\n    grid-row: 2;\n  }\n\n  /* 手机 overview 本源端点：左上类别上缘附近。 */\n  .spectrum-overview-dot.is-essence {\n    left: 25%;\n    top: 116px;\n  }\n\n  /* 手机 overview 现实端点：右上类别上缘附近。 */\n  .spectrum-overview-dot.is-reality {\n    left: 75%;\n    top: 116px;\n  }\n\n  /* 手机 overview 信息端点：中下类别上缘附近。 */\n  .spectrum-overview-dot.is-information {\n    left: 50%;\n    top: 186px;\n  }\n\n  /* 手机 overview 卡片：再缩一点，保证不横向裁切。 */\n  .spectrum-overview-tree .spectrum-card {\n    --spectrum-card-icon-size: 32px;\n    min-height: 42px;\n    padding: 5px 6px;\n    gap: 5px;\n  }\n\n  /* 手机 overview 标题：单行显示。 */\n  .spectrum-overview-tree .spectrum-card-title,\n  .spectrum-card.is-overview .spectrum-card-title {\n    font-size: 14px;\n  }\n}\n\n/* 谱系模块盒模型：避免卡片和 SVG 连接层计算宽度时溢出。 */\n.spectrum-classification,\n.spectrum-classification * {\n  box-sizing: border-box;\n}\n\n/* 谱系章节：沿用 character profile 的标题系统，仅控制本页区块间距。 */\n.spectrum-section {\n  display: grid;\n  gap: clamp(12px, 1.4vw, 18px);\n}\n\n/* 谱系章节相邻距离：让概览与详细谱系之间形成长页节奏。 */\n.spectrum-section + .spectrum-section {\n  margin-top: clamp(25px, 3.5vw, 49px);\n}\n\n/* 谱系页全局小装饰：隐藏 archive scroll decor 自带的小放射图。 */\n.archive-page:has(.spectrum-classification) .archive-scroll-decor .scroll-decor-group:first-child .scroll-decor-small {\n  display: none;\n}\n\n/* 概览小装饰：单独放入 overview，中心对齐 malice-ball 当前中心。 */\n.spectrum-overview-small-decor {\n  position: absolute;\n  left: 49%;\n  top: 46px;\n  z-index: 0;\n  display: block;\n  width: 30vw;\n  min-width: 195px;\n  height: auto;\n  object-fit: contain;\n  opacity: 1;\n  transform: translate(-50%, -50%);\n  pointer-events: none;\n  user-select: none;\n}\n\n/* 谱系白底面板：概览和详细树共用的低装饰容器。 */\n.spectrum-overview-panel,\n.spectrum-tree-panel {\n  position: relative;\n  z-index: 1;\n  border: 1px solid rgba(45, 95, 150, 0.24);\n  background: rgba(255, 255, 255, 0.88);\n  box-shadow:\n    inset 0 0 36px rgba(45, 95, 150, 0.035),\n    inset 0 0 48px rgba(200, 155, 90, 0.025);\n}\n\n/* 概览面板：给 root 卡、分支线和三张小卡留出固定纵深。 */\n.spectrum-overview-panel {\n  min-height: clamp(222px, 19vw, 268px);\n  overflow: visible;\n}\n\n/* 概览树画布：使用相对定位承载 SVG 连线和卡片层。 */\n.spectrum-overview-map {\n  --spectrum-overview-pad: clamp(22px, 5vw, 82px);\n  position: relative;\n  min-height: inherit;\n  padding: 22px var(--spectrum-overview-pad) 20px;\n}\n\n/* 概览树整体：只打包线、圆点和卡片整体下移，不包含 malice-ball。 */\n.spectrum-overview-tree {\n  --spectrum-overview-tree-shift: 60px;\n  position: relative;\n  z-index: 2;\n  min-height: inherit;\n  transform: translateY(var(--spectrum-overview-tree-shift));\n}\n\n/* 概览核心底图：把原 malice-ball 放回顶端，垫在卡片和连线下面。 */\n.spectrum-overview-core-bg {\n  position: absolute;\n  left: 50%;\n  top: 0;\n  z-index: 0;\n  display: grid;\n  place-items: center;\n  width: clamp(150px, 12vw, 202px);\n  aspect-ratio: 1;\n  opacity: 1;\n  transform: translate(-50%, -50%);\n  pointer-events: none;\n}\n\n/* 概览核心底图图片：保持素材完整，不影响实际卡片布局。 */\n.spectrum-overview-core-bg img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n}\n\n/* 概览 SVG 连线：只负责恶能 root 到三类卡片的直角树线。 */\n.spectrum-overview-connector {\n  position: absolute;\n  left: 0;\n  top: 0;\n  z-index: 2;\n  width: 100%;\n  height: 176px;\n  pointer-events: none;\n}\n\n/* 姒傝绐勫睆鍙屾帓 SVG锛氶粯璁ら殣钘忥紝浠呭湪 620px 浠ヤ笅鎺ュ浣滅敤銆?*/\n.spectrum-overview-connector.is-stacked {\n  display: none;\n}\n\n/* 概览圆点图层：与 SVG 连线同宽同高，但圆点本身不参与 SVG 拉伸。 */\n.spectrum-overview-dot-layer {\n  position: absolute;\n  left: 0;\n  top: 0;\n  z-index: 4;\n  width: 100%;\n  height: 176px;\n  pointer-events: none;\n}\n\n/* 概览独立圆点：脱离 SVG 缩放，避免横向拉伸成椭圆。 */\n.spectrum-overview-dot {\n  position: absolute;\n  width: 9px;\n  height: 9px;\n  border: 1px solid var(--spectrum-line-strong);\n  border-radius: 50%;\n  background: rgba(255, 255, 255, 0.98);\n  box-shadow: 0 0 0 2px rgba(200, 155, 90, 0.11);\n  transform: translate(-50%, -50%);\n  pointer-events: none;\n}\n\n/* 概览实心圆点：用于连接到卡片边缘的端点。 */\n.spectrum-overview-dot.is-solid {\n  background: var(--spectrum-line-strong);\n}\n\n/* 概览 root 端点：对齐恶能卡片底部中心。 */\n.spectrum-overview-dot.is-root {\n  left: 50%;\n  top: 58px;\n}\n\n/* 概览中继节点：三分支在此处分流。 */\n.spectrum-overview-dot.is-joint {\n  left: 50%;\n  top: 100px;\n}\n\n/* 概览本源类端点：对齐左侧卡片顶部中心。 */\n.spectrum-overview-dot.is-essence {\n  left: 16.6667%;\n  top: 118px;\n}\n\n/* 概览现实类端点：对齐中间卡片顶部中心。 */\n.spectrum-overview-dot.is-reality {\n  left: 50%;\n  top: 118px;\n}\n\n/* 概览信息类端点：对齐右侧卡片顶部中心。 */\n.spectrum-overview-dot.is-information {\n  left: 83.3333%;\n  top: 118px;\n}\n\n/* 概览 root 卡：恶能节点置于树的顶部中心。 */\n.spectrum-overview-root {\n  position: relative;\n  z-index: 3;\n  width: 158px;\n  margin: 0 auto;\n}\n\n/* 概览三类卡容器：三张小卡等宽排列在 root 下方。 */\n.spectrum-overview-classes {\n  position: relative;\n  z-index: 3;\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  justify-content: stretch;\n  gap: 0;\n  margin-top: 60px;\n}\n\n/* 概览类别节点：保持每张小卡同宽同高。 */\n.spectrum-overview-node {\n  width: 158px;\n  justify-self: center;\n}\n\n/* 说明框：复用 character note 的金色框，但正文自然左对齐。 */\n.spectrum-overview-note {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr);\n  margin-top: clamp(8px, 1vw, 12px);\n}\n\n/* 说明框文字容器：去掉人物页窄文本列带来的大块左空白。 */\n.spectrum-overview-note .character-note-copy {\n  width: 100%;\n  max-width: none;\n  min-width: 0;\n  margin: 0;\n  padding-right: 0;\n  white-space: normal;\n  overflow-wrap: anywhere;\n  word-break: normal;\n}\n\n/* 说明框段落：复用角色档案人物概述的自然段格式。 */\n.spectrum-overview-note .character-note-copy p {\n  margin: 0 10vw 18px 10vw;\n  max-width: 100%;\n  text-align: left;\n  text-indent: 2em;\n}\n\n/* 说明框最后一段：复用角色档案人物概述的收尾格式。 */\n.spectrum-overview-note .character-note-copy p:last-child {\n  margin-bottom: 0;\n}\n\n/* 谱系页下一页入口：custom 模式下把页末按钮推到最后容器下方。 */\n.spectrum-classification + .content-frame-next-link-standalone {\n  margin-top: clamp(34px, 4vw, 62px);\n  margin-bottom: clamp(28px, 3vw, 46px);\n}\n\n/* 谱系 SVG 线条：所有连接线统一使用金色 1px 直角线。 */\n.spectrum-line-path {\n  fill: none;\n  stroke: var(--spectrum-line);\n  stroke-linecap: butt;\n  stroke-linejoin: miter;\n  stroke-width: 1;\n  vector-effect: non-scaling-stroke;\n}\n\n/* 谱系 SVG 节点：空心圆覆盖在线上，避免竖线从圆点中穿出。 */\n.spectrum-line-node {\n  fill: rgba(255, 255, 255, 0.98);\n  stroke: var(--spectrum-line-strong);\n  stroke-width: 1;\n  vector-effect: non-scaling-stroke;\n}\n\n/* 谱系 SVG 实心节点：用于连接到卡片边缘的端点。 */\n.spectrum-line-node.is-solid {\n  fill: var(--spectrum-line-strong);\n}\n\n/* 谱系卡片基础：接近 ability card，但用主题变量控制边框和标题色。 */\n.spectrum-card {\n  --spectrum-card-accent: rgba(174, 119, 55, 0.94);\n  --spectrum-card-accent-soft: rgba(200, 155, 90, 0.32);\n  --spectrum-card-accent-wash: rgba(224, 194, 143, 0.12);\n  --spectrum-card-accent-text: rgba(143, 93, 53, 0.96);\n  --spectrum-card-icon-size: 52px;\n  position: relative;\n  display: grid;\n  grid-template-columns: var(--spectrum-card-icon-size) minmax(0, 1fr);\n  align-items: center;\n  gap: 9px;\n  width: 100%;\n  max-width: 100%;\n  padding: 9px 10px;\n  border: 1px solid color-mix(in srgb, var(--spectrum-card-accent) 68%, rgba(255, 255, 255, 0.35));\n  border-radius: 6px;\n  background:\n    linear-gradient(135deg, rgba(255, 255, 255, 0.84), var(--spectrum-card-accent-wash)),\n    rgba(251, 250, 246, 0.76);\n  box-shadow:\n    inset 0 0 22px var(--spectrum-card-accent-wash),\n    0 6px 20px rgba(21, 21, 21, 0.03);\n  overflow: hidden;\n}\n\n/* 谱系卡片箭头：详细卡保留右侧指示符，overview 小卡隐藏。 */\n.spectrum-card::after {\n  content: \">\";\n  position: absolute;\n  right: 9px;\n  top: 50%;\n  color: var(--spectrum-card-accent-text);\n  font-family: var(--font-latin);\n  font-size: 19px;\n  font-weight: 400;\n  line-height: 1;\n  opacity: 0.58;\n  transform: translateY(-50%);\n}\n\n/* 概览卡片变体：只显示图案和中文标题，尺寸明显缩小。 */\n.spectrum-card.is-overview {\n  --spectrum-card-icon-size: 42px;\n  min-height: 58px;\n  padding: 7px 10px;\n  gap: 8px;\n}\n\n/* 概览卡片箭头：概览树不需要可进入提示。 */\n.spectrum-card.is-overview::after {\n  display: none;\n}\n\n/* 大类卡片变体：比谱系卡略大，用于 detailed tree 中列。 */\n.spectrum-card.is-class {\n  --spectrum-card-icon-size: 66px;\n  padding: 12px 14px;\n}\n\n/* 谱系小卡变体：固定高度以配合连接层坐标。 */\n.spectrum-card.is-lineage {\n  padding: 12px 14px;\n}\n\n/* 卡片图标圆框：黑色底圆固定，图标在圆心绝对居中。 */\n.spectrum-card-icon {\n  position: relative;\n  display: grid;\n  place-items: center;\n  width: var(--spectrum-card-icon-size);\n  height: var(--spectrum-card-icon-size);\n  border: 1px solid rgba(45, 95, 150, 0.72);\n  border-radius: 50%;\n  background: #050505;\n  overflow: visible;\n}\n\n/* 卡片图标图片：不单独缩小素材，只随圆框尺寸整体变化。 */\n.spectrum-card-icon img {\n  position: absolute;\n  left: 50%;\n  top: 50%;\n  width: calc(var(--spectrum-card-icon-size) + 20px);\n  height: calc(var(--spectrum-card-icon-size) + 20px);\n  max-width: none;\n  max-height: none;\n  object-fit: contain;\n  transform: translate(-50%, -50%);\n}\n\n/* 卡片文字列：预留箭头空间并防止长文本撑开布局。 */\n.spectrum-card-copy {\n  min-width: 0;\n  padding-right: 10px;\n}\n\n/* 卡片中文标题：主题色跟随卡片变量，字号保持克制。 */\n.spectrum-card-title {\n  margin: 0;\n  color: var(--spectrum-card-accent-text);\n  font-size: 22px;\n  font-weight: 900;\n  line-height: 1.15;\n  letter-spacing: 0;\n  overflow-wrap: anywhere;\n}\n\n/* 概览卡片标题：小卡标题比详细正文略突出。 */\n.spectrum-card.is-overview .spectrum-card-title {\n  font-size: 18px;\n}\n\n/* 谱系卡标题：小卡标题统一高度节奏。 */\n.spectrum-card.is-lineage .spectrum-card-title {\n  font-size: 20px;\n}\n\n/* 卡片副标题：英文类别或谱系本质使用主题色。 */\n.spectrum-card-subtitle {\n  margin: 3px 0 0;\n  color: var(--spectrum-card-accent-text);\n  font-family: var(--font-latin);\n  font-size: 12px;\n  font-weight: 800;\n  line-height: 1.2;\n  letter-spacing: 0;\n  overflow-wrap: anywhere;\n}\n\n/* 谱系卡副标题：中文“谱系本质”使用正文无衬线字体。 */\n.spectrum-card.is-lineage .spectrum-card-subtitle {\n  font-family: var(--font-sans);\n  font-size: 16px;\n}\n\n/* 卡片描述：正文固定黑色，不跟随主题色变化。 */\n.spectrum-card-description {\n  margin: 6px 0 0;\n  color: var(--color-ink);\n  font-size: 16px;\n  font-weight: 400;\n  line-height: 1.45;\n  overflow-wrap: anywhere;\n}\n\n/* 详细树面板：为左侧核心、类别卡和谱系卡提供呼吸空间。 */\n.spectrum-tree-panel {\n  padding: clamp(28px, 3vw, 44px) clamp(24px, 3.2vw, 46px);\n  overflow: visible;\n}\n\n/* 详细树画布：定义各列宽度，并允许宽屏继续向右展开。 */\n.spectrum-tree {\n  --spectrum-root-column: 156px;\n  --spectrum-detail-card-width: clamp(270px, 27vw, 360px);\n  --spectrum-connector-column: 100px;\n  --spectrum-class-column: var(--spectrum-detail-card-width);\n  --spectrum-lineage-card-width: var(--spectrum-detail-card-width);\n  position: relative;\n  width: fit-content;\n  max-width: 100%;\n  margin-inline: auto;\n  min-width: 0;\n  inline-size: fit-content;\n  max-inline-size: 100%;\n  min-inline-size: 0;\n}\n\n.spectrum-tree-groups {\n  width: calc(\n    var(--spectrum-root-column) +\n    var(--spectrum-class-column) +\n    var(--spectrum-connector-column) +\n    var(--spectrum-lineage-card-width)\n  );\n}\n\n/* 详细树 root SVG：画左侧 spine 和到三张大类卡的横线。 */\n.spectrum-root-connector {\n  position: absolute;\n  left: 0;\n  top: 0;\n  z-index: 1;\n  width: var(--spectrum-root-column);\n  height: var(--spectrum-tree-height);\n  pointer-events: none;\n}\n\n/* 详细树核心图：旋转 malice-ball 覆盖在现实类卡片中点高度。 */\n.spectrum-tree-root {\n  position: absolute;\n  left: 60px;\n  top: var(--spectrum-root-core-y);\n  z-index: 2;\n  display: grid;\n  place-items: center;\n  width: clamp(210px, 20vw, 310px);\n  aspect-ratio: 1;\n  border-radius: 50%;\n  background: radial-gradient(circle, rgba(255, 255, 255, 0.96) 0 34%, rgba(255, 255, 255, 0) 68%);\n  opacity: 0.72;\n  transform: translate(-50%, -50%) rotate(-90deg);\n  pointer-events: none;\n}\n\n/* 详细树核心图片：保持素材完整显示，不参与布局宽度计算。 */\n.spectrum-tree-root img {\n  position: relative;\n  z-index: 2;\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n  filter: drop-shadow(0 10px 20px rgba(45, 95, 150, 0.12));\n}\n\n/* 详细树分组列：按 2/5/3 谱系堆叠，gap 与组件坐标一致。 */\n.spectrum-tree-groups {\n  position: relative;\n  z-index: 3;\n  display: grid;\n  gap: var(--spectrum-group-gap);\n}\n\n/* 详细树单个大类组：让大类卡在本组总高度中点对齐。 */\n.spectrum-tree-group {\n  position: relative;\n  display: grid;\n  grid-template-columns:\n    var(--spectrum-root-column)\n    var(--spectrum-class-column)\n    var(--spectrum-connector-column)\n    minmax(0, var(--spectrum-lineage-card-width));\n  align-items: center;\n  height: var(--spectrum-group-height);\n  min-width: 0;\n}\n\n/* 详细树大类卡列：位于左侧 root 连接线和右侧谱系分支之间。 */\n.spectrum-tree-class {\n  position: relative;\n  z-index: 3;\n  grid-column: 2;\n  align-self: center;\n  justify-self: stretch;\n}\n\n/* 详细树组内 SVG：统一绘制大类到谱系卡的横线、竖线和节点。 */\n.spectrum-group-connector {\n  position: absolute;\n  left: calc(var(--spectrum-root-column) + var(--spectrum-class-column));\n  top: 0;\n  z-index: 2;\n  width: var(--spectrum-connector-column);\n  height: var(--spectrum-group-height);\n  pointer-events: none;\n}\n\n/* 详细树谱系列：固定行高和行距，和 SVG 坐标逐行对应。 */\n.spectrum-tree-lineages {\n  grid-column: 4;\n  display: grid;\n  grid-template-rows: repeat(var(--lineage-count), var(--spectrum-detail-card-height));\n  gap: var(--spectrum-lineage-gap);\n  align-self: stretch;\n  min-width: 0;\n}\n\n/* 详细树谱系行：只承载卡片，连接线由 SVG 层统一处理。 */\n.spectrum-lineage-row {\n  position: relative;\n  display: block;\n  min-width: 0;\n}\n\n/* 详细树谱系卡：高度锁定，保证所有连接端点对齐卡片中线。 */\n.spectrum-tree-class > .spectrum-card,\n.spectrum-lineage-row > .spectrum-card {\n  height: var(--spectrum-detail-card-height);\n}\n\n/* 本页正文覆盖：避免 archive 正文样式给卡片段落加缩进。 */\n.content-prose .spectrum-classification p {\n  text-indent: 0;\n}\n\n/* 璇存槑妗嗘钀斤細鍦ㄦ湰椤靛叏灞€ p 閲嶇疆涔嬪悗锛屾仮澶嶄汉鐗╂杩扮殑鑷劧娈垫牸銆?*/\n.content-prose .spectrum-classification .spectrum-overview-note .character-note-copy p {\n  margin: 0 0 18px;\n  max-width: 100%;\n  text-indent: 2em;\n}\n\n/* 璇存槑妗嗘渶鍚庢钀斤細淇濇寔閲戣壊妗嗗唴鐨勬敹灏惧竷灞€銆?*/\n.content-prose .spectrum-classification .spectrum-overview-note .character-note-copy p:last-child {\n  margin-bottom: 0;\n}\n\n/* 中等宽度布局：缩小左移和卡列，保留完整树状结构。 */\n@media (max-width: 1180px) {\n  /* 中等宽度主容器：减少右移幅度，避免碰到视口边缘。 */\n  .spectrum-classification {\n    --spectrum-page-shift: clamp(34px, 4vw, 58px);\n  }\n\n  /* 中等宽度详细树：压缩类别卡和谱系卡宽度。 */\n}\n\n/* 窄屏布局：隐藏复杂连线，改为可读的单列谱系列表。 */\n@media (max-width: 980px) {\n  /* 窄屏主容器：取消桌面右移，使用视口内安全宽度。 */\n  .spectrum-classification {\n    width: 100%;\n    max-width: 100%;\n    margin-top: 20px;\n    margin-left: 0;\n    margin-right: auto;\n    overflow-x: clip;\n  }\n\n  /* 窄屏面板：限制所有本页容器不超过视口宽度。 */\n  .spectrum-overview-panel,\n  .spectrum-overview-note,\n  /* 窄屏概览画布：改成缩小版桌面树，避免左侧假树线随卡片宽度脱节。 */\n  .spectrum-overview-map {\n    display: block;\n    min-height: 150px;\n    padding: 0;\n  }\n\n  /* 窄屏概览树：使用绝对定位 SVG 和横排卡片，不再使用左侧 border 假树。 */\n  .spectrum-overview-tree {\n    position: relative;\n    display: block;\n    --spectrum-overview-card-width: 120px;\n    min-height: 150px;\n    padding-left: 0;\n    border-left: 0;\n  }\n\n  /* 窄屏概览连线：恢复横排 SVG 直角树。 */\n  .spectrum-overview-connector.is-inline {\n    display: block;\n    height: 132px;\n  }\n\n  /* 窄屏概览双排连线：620px 以上保持隐藏。 */\n  .spectrum-overview-connector.is-stacked {\n    display: none;\n  }\n\n  /* 窄屏概览圆点层：跟随缩小 SVG 树显示端点。 */\n  .spectrum-overview-dot-layer {\n    display: block;\n    height: 132px;\n  }\n\n  /* 窄屏概览根卡：恶能位于上方中心。 */\n  .spectrum-overview-root {\n    position: relative;\n    z-index: 3;\n    width: clamp(132px, 22vw, 170px);\n    max-width: none;\n    margin: 0 auto;\n  }\n\n  /* 窄屏概览根卡横线：由 SVG 接管。 */\n  .spectrum-overview-root::before {\n    content: none;\n  }\n\n  /* 窄屏概览类别：620px 以上三张横排。 */\n  .spectrum-overview-classes {\n    position: relative;\n    z-index: 3;\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    align-items: center;\n    gap: 6px;\n    width: 100%;\n    margin-top: 44px;\n  }\n\n  /* 窄屏概览类别节点：小卡固定在各自列中心。 */\n  .spectrum-overview-node {\n    position: relative;\n    width: min(100%, 112px);\n    justify-self: center;\n  }\n\n  /* 窄屏概览类别横线：由 SVG 接管。 */\n  .spectrum-overview-node::before {\n    content: none;\n  }\n\n  /* 窄屏概览卡片：缩小图标和内边距，使三列能在宽屏移动端放下。 */\n  .spectrum-overview-tree .spectrum-card {\n    --spectrum-card-icon-size: clamp(28px, 5.2vw, 36px);\n    min-height: 44px;\n    padding: 6px 7px;\n    gap: 5px;\n  }\n\n  /* 窄屏概览标题：控制字级，避免小卡撑开。 */\n  .spectrum-overview-tree .spectrum-card-title {\n    font-size: clamp(13px, 3.1vw, 16px);\n  }\n\n  .spectrum-tree-panel {\n    width: 100%;\n    max-width: 100%;\n  }\n\n  /* 窄屏概览面板：从横向树改为紧凑纵向内容。 */\n  .spectrum-overview-panel {\n    min-height: 0;\n    padding: 18px 14px;\n    overflow: visible;\n  }\n\n  /* 窄屏概览画布：取消桌面绝对连线所需的高度。 */\n  .spectrum-overview-map {\n    display: grid;\n    gap: 10px;\n    min-height: 0;\n    padding: 0;\n  }\n\n  /* 窄屏概览树整体：移动端不做桌面下移。 */\n  .spectrum-overview-tree {\n    --spectrum-overview-tree-shift: 0px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 10px;\n    width: 100%;\n    max-width: 100%;\n    margin: 0 auto;\n    min-height: 0;\n    padding-left: 12px;\n    border-left: 1px solid var(--spectrum-line);\n  }\n\n  /* 窄屏概览连线：移动端隐藏复杂树线，优先保证阅读。 */\n  .spectrum-overview-connector {\n    display: none;\n  }\n\n  /* 窄屏概览圆点：移动端隐藏复杂树节点，避免悬浮错位。 */\n  .spectrum-overview-dot-layer {\n    display: none;\n  }\n\n  /* 窄屏概览核心底图：隐藏顶部装饰，避免压到单列卡片。 */\n  .spectrum-overview-core-bg {\n    display: none;\n  }\n\n  /* 窄屏概览小装饰：移动端不使用桌面的 overview 对齐装饰。 */\n  .spectrum-overview-small-decor {\n    display: none;\n  }\n\n  /* 窄屏概览 root 卡：与下方类别卡同宽居中。 */\n  .spectrum-overview-root {\n    position: relative;\n    width: 100%;\n    max-width: none;\n    margin: 0;\n  }\n\n  /* 窄屏概览 root 横线：从左侧竖线接到“恶能”大卡中点。 */\n  .spectrum-overview-root::before {\n    content: \"\";\n    position: absolute;\n    left: -13px;\n    top: 50%;\n    width: 13px;\n    height: 1px;\n    background: var(--spectrum-line);\n    transform: translateY(-50%);\n    pointer-events: none;\n  }\n\n  /* 窄屏概览三类卡：改为单列堆叠。 */\n  .spectrum-overview-classes {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 10px;\n    width: 86%;\n    max-width: none;\n    margin-top: 0;\n  }\n\n  /* 窄屏概览节点：所有小卡使用相同安全宽度。 */\n  .spectrum-overview-node {\n    position: relative;\n    width: 100%;\n    max-width: none;\n  }\n\n  /* 窄屏概览类别横线：从左侧竖线接到稍短的类别小卡中点。 */\n  .spectrum-overview-node::before {\n    content: \"\";\n    position: absolute;\n    left: clamp(-31px, -20vw, -80px);\n    top: 50%;\n    width: clamp(31px, 20vw, 80px);\n    height: 1px;\n    background: var(--spectrum-line);\n    transform: translateY(-50%);\n    pointer-events: none;\n  }\n\n  /* 窄屏概览卡片内部：复用详细树的文字列收口，避免横向裁切。 */\n  .spectrum-overview-tree .spectrum-card {\n    grid-template-columns: var(--spectrum-card-icon-size) minmax(0, calc(100% - var(--spectrum-card-icon-size) - 8px));\n  }\n\n  /* 窄屏概览文字列：强制使用卡片剩余宽度。 */\n  .spectrum-overview-tree .spectrum-card-copy {\n    width: 100%;\n    max-width: 100%;\n    min-width: 0;\n    overflow: hidden;\n  }\n\n  /* 窄屏详细树面板：减小内边距让卡片有足够宽度。 */\n  .spectrum-tree-panel {\n    padding: 18px 14px;\n  }\n\n  /* 窄屏详细树画布：取消桌面 min-width，防止横向滚动。 */\n  .spectrum-tree {\n    width: 100%;\n    max-width: 100%;\n    min-width: 0;\n    inline-size: 100%;\n    max-inline-size: 100%;\n  }\n\n  /* 窄屏详细树连接层：隐藏 SVG 和核心图，保留卡片层级。 */\n  .spectrum-root-connector,\n  .spectrum-tree-root,\n  .spectrum-group-connector {\n    display: none;\n  }\n\n  /* 窄屏详细树分组：减少组间距离。 */\n  .spectrum-tree-groups {\n    width: 100%;\n    min-width: 0;\n    gap: 20px;\n  }\n\n  /* 窄屏详细树单组：改为一列，并用左边线提示层级。 */\n  .spectrum-tree-group {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 10px;\n    height: auto;\n    padding-left: 12px;\n    border-left: 1px solid var(--spectrum-line);\n    min-width: 0;\n  }\n\n  /* 窄屏大类卡和谱系列：统一落入第一列。 */\n  .spectrum-tree-class,\n  .spectrum-tree-lineages {\n    grid-column: 1;\n    justify-self: center;\n    min-width: 0;\n  }\n\n  /* 窄屏详细树大类卡：跟随面板可用宽度，保持单列居中。 */\n  .spectrum-tree-class {\n    position: relative;\n    width: 100%;\n    max-width: none;\n  }\n\n  /* 窄屏详细树大类横线：从左侧竖线接到大类卡中点。 */\n  .spectrum-tree-class::before {\n    content: \"\";\n    position: absolute;\n    left: -13px;\n    top: 50%;\n    width: 13px;\n    height: 1px;\n    background: var(--spectrum-line);\n    transform: translateY(-50%);\n    pointer-events: none;\n  }\n\n  /* 窄屏谱系列：取消固定行高，由内容自然撑开。 */\n  .spectrum-tree-lineages {\n    display: grid;\n    grid-template-rows: none;\n    gap: 10px;\n    width: 86%;\n    max-width: none;\n    justify-self: center;\n  }\n\n  /* 窄屏谱系行：每行只显示一张卡片。 */\n  .spectrum-lineage-row {\n    position: relative;\n    display: block;\n    width: 100%;\n    max-width: none;\n  }\n\n  /* 窄屏详细树谱系横线：从左侧竖线接到谱系小卡中点，形成假树状分支。 */\n  .spectrum-lineage-row::before {\n    content: \"\";\n    position: absolute;\n    left: -13px;\n    top: 50%;\n    width: 13px;\n    height: 1px;\n    background: var(--spectrum-line);\n    transform: translateY(-50%);\n    pointer-events: none;\n  }\n\n  /* 窄屏详细树文本：显式允许换行，避免继承 archive 正文的普通断行策略。 */\n  .spectrum-tree .spectrum-card-title,\n  .spectrum-tree .spectrum-card-subtitle,\n  .spectrum-tree .spectrum-card-description {\n    white-space: normal;\n    overflow-wrap: anywhere;\n    word-break: break-word;\n  }\n\n  /* 窄屏详细树卡片内部：图标列固定，文字列严格使用剩余宽度。 */\n  .spectrum-tree .spectrum-card {\n    grid-template-columns: var(--spectrum-card-icon-size) minmax(0, calc(100% - var(--spectrum-card-icon-size) - 9px));\n  }\n\n  /* 窄屏详细树文字列：阻止正文按内容宽度撑开卡片。 */\n  .spec