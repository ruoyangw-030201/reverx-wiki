  .spectrum-overview-classes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: center;
    gap: 6px;
    width: 100%;
    margin-top: 44px;
  }

  /* 窄屏概览类别节点：卡片位于各列中心。 */
  .spectrum-overview-node {
    width: min(100%, clamp(132px, 22vw, 170px));
    justify-self: center;
  }

  /* 窄屏概览类别伪线：由 SVG 接管。 */
  .spectrum-overview-node::before {
