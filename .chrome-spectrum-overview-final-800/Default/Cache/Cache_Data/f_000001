<style data-vite-dev-id="D:/Projects/reverx-wiki/src/styles/active-marker.css">/* ========== shared active marker ========== */

.archive-hourglass-marker {
  --archive-hourglass-color: var(--color-gold);
  position: absolute;
  display: none;
  width: 18px;
  height: 28px;
  color: var(--archive-hourglass-color);
  pointer-events: none;
}

.archive-hourglass-body {
  position: absolute;
  inset: 0;
  display: block;
  transform-origin: 50% 50%;
  animation: archive-hourglass-flip 2.8s ease-in-out infinite;
}

.archive-hourglass-body::before,
.archive-hourglass-body::after {
  content: "";
  position: absolute;
  left: 1px;
  right: 1px;
  height: 2px;
  border-radius: 999px;
  background: currentColor;
}

.archive-hourglass-body::before {
  top: 0;
}

.archive-hourglass-body::after {
  bottom: 0;
}

.archive-hourglass-line {
  position: absolute;
  left: 8px;
  top: -1px;
  width: 2px;
  height: 30px;
  border-radius: 999px;
  background: currentColor;
  transform: rotate(30deg);
  transform-origin: center center;
}

.archive-hourglass-line::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 2px;
  height: 30px;
  border-radius: inherit;
  background: currentColor;
  transform: rotate(-60deg);
  transform-origin: center center;
}

.archive-hourglass-fill {
  position: absolute;
  left: 50%;
  width: 0;
  height: 0;
  transform: translateX(-50%);
}

.archive-hourglass-fill-top {
  top: 8px;
  border-left: 5px solid transparent;
  border-right: 5px solid transparent;
  border-top: 8px solid currentColor;
}

.archive-hourglass-fill-bottom {
  bottom: 5px;
  border-left: 7px solid transparent;
  border-right: 7px solid transparent;
  border-bottom: 11px solid currentColor;
}

@keyframes archive-hourglass-flip {
  0% {
    transform: rotate(0deg);
  }

  16% {
    transform: rotate(180deg);
  }

  50% {
    transform: rotate(180deg);
  }

  66% {
    transform: rotate(360deg);
  }

  100% {
    transform: rotate(360deg);
  }
}

/* ========== shared directional arrow marker ========== */

.active-direction-marker {
  --active-direction-color: var(--color-blue);
  --active-direction-size: 48px;
  --active-direction-rotate: 0deg;
  --active-direction-blade-width: calc(var(--active-direction-size) * 0.33);
  --active-direction-blade-height: calc(var(--active-direction-size) * 0.22);
  --active-direction-blade-copy-x: calc(var(--active-direction-size) * 0.25);
  --active-direction-blade-left: calc(var(--active-direction-size) * 0.12);
  --active-direction-blade-top: calc(var(--active-direction-size) * 0.22);
  --active-direction-blade-row-gap: calc(var(--active-direction-size) * 0.25);

  position: fixed;
  z-index: 50;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: var(--active-direction-color);
  pointer-events: none;
  user-select: none;
}

.active-direction-marker::before {
  content: attr(data-label);
  display: none;
  font-size: 10px;
  font-family: var(--font-latin);
  line-height: 1;
  letter-spacing: 0.24em;
  font-weight: 900;
  color: currentColor;
}

.active-direction-marker[data-label]::before {
  display: block;
}

.active-direction-marker__icon {
  position: relative;
  display: block;
  width: var(--active-direction-size);
  height: var(--active-direction-size);
  transform: rotate(var(--active-direction-rotate));
}

.active-direction-marker__blade {
  position: absolute;
  left: var(--active-direction-blade-left);
  top: var(--active-direction-blade-top);
  display: block;
  width: var(--active-direction-blade-width);
  height: var(--active-direction-blade-height);
  background: currentColor;
  clip-path: polygon(
    0 0,
    calc(100% - var(--active-direction-blade-height)) 0,
    100% 100%,
    var(--active-direction-blade-height) 100%
  );
  transform-origin: center;
}

.active-direction-marker__blade:nth-child(1) {
  transform: translate(0, 0);
}

.active-direction-marker__blade:nth-child(2) {
  transform: translateX(var(--active-direction-blade-copy-x));
}

.active-direction-marker__blade:nth-child(3) {
  transform: translateY(var(--active-direction-blade-row-gap)) scaleY(-1);
}

.active-direction-marker__blade:nth-child(4) {
  transform: translate(var(--active-direction-blade-copy-x), var(--active-direction-blade-row-gap)) scaleY(-1);
}

/* right */
.active-direction-marker--right {
  top: 60%;
  right: clamp(0px, 1.5vw, 26px);
  transform: translateY(-50%);
  --active-direction-rotate: 0deg;
}

/* down */
.active-direction-marker--down {
  left: 50%;
  bottom: clamp(0px, 0.5vh, 8px);
  transform: translateX(-50%);
  --active-direction-rotate: 90deg;
  --active-direction-move-x: 0px;
  --active-direction-move-y: 12px;
  animation: active-direction-marker-loop 1.35s cubic-bezier(0.35, 0, 0.2, 1) infinite;
}

@keyframes active-direction-marker-loop {
  0% {
    opacity: 1;
    translate: 0 0;
  }

  55% {
    opacity: 1;
    translate: var(--active-direction-move-x) var(--active-direction-move-y);
  }

  75% {
    opacity: 0;
    translate: var(--active-direction-move-x) var(--active-direction-move-y);
  }

  76% {
    opacity: 0;
    translate: 0 0;
  }

  100% {
    opacity: 1;
    translate: 0 0;
  }
}

@media (max-width: 980px) {
  .active-direction-marker {
    --active-direction-blade-left: calc(var(--active-direction-size) * 0.21);
  }

  .active-direction-marker--down {
    flex-direction: column-reverse;
    gap: 2px;
    --active-direction-rotate: 270deg;
    --active-direction-move-y: -12px;
  }

  .active-direction-marker--down::before {
    content: attr(data-mobile-label);
    text-align: center;
  }

  .active-direction-marker--down:not([data-mobile-label])::before {
    content: attr(data-label);
  }
}

@media (prefers-reduced-motion: reduce) {
  .archive-hourglass-body,
  .active-direction-marker {
    animation: none;
  }

  .archive-hourglass-body {
    transform: rotate(0deg);
  }
}
</style>
