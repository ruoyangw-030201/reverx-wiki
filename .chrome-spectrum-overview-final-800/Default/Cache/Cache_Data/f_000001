  .spectrum-overview-root {
    width: clamp(106px, 30vw, 132px);
    margin: 0 auto;
  }

  /* 窄屏概览根卡伪线：由 SVG 接管。 */
  .spectrum-overview-root::before {
    content: none;
  }

