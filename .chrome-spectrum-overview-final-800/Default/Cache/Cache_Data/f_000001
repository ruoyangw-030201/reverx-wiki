  .spectrum-overview-tree .spectrum-card {
    --spectrum-card-icon-size: clamp(28px, 8.5vw, 36px);
    min-height: 44px;
    padding: 6px 7px;
    gap: 5px;
  }

  /* 手机概览标题：覆盖全局手机标题尺寸，避免卡片过宽。 */
  .spectrum-overview-tree .spectrum-card-title,
  .spectrum-card.is-overview .spectrum-card-title {
    font-size: clamp(13px, 4.1vw, 16px);
    white-space: nowrap;
    overflow-wrap: normal;
    word-break: keep-all;
  }
}
