  .spectrum-overview-node.is-essence {
    grid-column: 1;
    grid-row: 1;
  }

  /* 手机概览现实类：右上。 */
  .spectrum-overview-node.is-reality {
    grid-column: 2;
    grid-row: 1;
  }

  /* 手机概览信息类：中下。 */
  .spectrum-overview-node.is-information {
    grid-column: 1 / -1;
    grid-row: 2;
  }

