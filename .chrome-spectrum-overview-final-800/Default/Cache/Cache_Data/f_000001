/* 概览中继节点：三分支在此处分流。 */
.spectrum-overview-dot.is-joint {
  left: 50%;
  top: 100px;
}

/* 概览本源类端点：对齐左侧卡片顶部中心。 */
.spectrum-overview-dot.is-essence {
  left: 16.6667%;
  top: 118px;
}

/* 概览现实类端点：对齐中间卡片顶部中心。 */
.spectrum-overview-dot.is-reality {
  left: 50%;
  top: 118px;
}

/* 概览信息类端点：对齐右侧卡片顶部中心。 */
.spectrum-overview-dot.is-information {
  left: 83.3333%;
  top: 118px;
}

/* 概览 root 卡：恶能节点置于树的顶部中心。 */
.spectrum-overview-root {
  position: relative;
  z-index: 3;
  width: 158px;
  margin: 0 auto;
}

/* 概览三类卡容器：三张小卡等宽排列在 root 下方。 */
.spectrum-overview-classes {
  position: relative;
  z-index: 3;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  justify-content: stretch;
  gap: 0;
  margin-top: 60px;
}

/* 概览类别节点：保持每张小卡同宽同高。 */
.spectrum-overview-node {
  width: 158px;
  justify-self: center;
}

/* 说明框：复用 character note 的金色框，但正文自然左对齐。 */
.spectrum-overview-note {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  margin-top: clamp(8px, 1vw, 12px);
}

/* 说明框文字容器：去掉人物页窄文本列带来的大块左空白。 */
.spectrum-overview-note .character-note-copy {
  width: 100%;
  max-width: none;
  min-width: 0;
  margin: 0;
  padding-right: 0;
  white-space: normal;
  overflow-wrap: anywhere;
  word-break: normal;
}

/* 说明框段落：复用角色档案人物概述的自然段格式。 */
.spectrum-overview-note .character-note-copy p {
  margin: 0 0 18px;
  max-width: 100%;
  text-align: left;
  text-indent: 2em;
}

/* 说明框最后一段：复用角色档案人物概述的收尾格式。 */
.spectrum-overview-note .character-note-copy p:last-child {
  margin-bottom: 0;
}

/* 谱系页下一页入口：custom 模式下把页末按钮推到最后容器下方。 */
.spectrum-classification + .content-frame-next-link-standalone {
  margin-top: clamp(34px, 4vw, 62px);
  margin-bottom: clamp(28px, 3vw, 46px);
}

/* 谱系 SVG 线条：所有连接线统一使用金色 1px 直角线。 */
.spectrum-line-path {
  fill: none;
  stroke: var(--spectrum-line);
  stroke-linecap: butt;
  stroke-linejoin: miter;
  stroke-width: 1;
  vector-effect: non-scaling-stroke;
}

/* 谱系 SVG 节点：空心圆覆盖在线上，避免竖线从圆点中穿出。 */
.spectrum-line-node {
  fill: rgba(255, 255, 255, 0.98);
  stroke: var(--spectrum-line-strong);
  stroke-width: 1;
  vector-effect: non-scaling-stroke;
}

/* 谱系 SVG 实心节点：用于连接到卡片边缘的端点。 */
.spectrum-line-node.is-solid {
  fill: var(--spectrum-line-strong);
}

/* 谱系卡片基础：接近 ability card，但用主题变量控制边框和标题色。 */
.spectrum-card {
  --spectrum-card-accent: rgba(174, 119, 55, 0.94);
  --spectrum-card-accent-soft: rgba(200, 155, 90, 0.32);
  --spectrum-card-accent-wash: rgba(224, 194, 143, 0.12);
  --spectrum-card-accent-text: rgba(143, 93, 53, 0.96);
  --spectrum-card-icon-size: 52px;
  position: relative;
  display: grid;
  grid-template-columns: var(--spectrum-card-icon-size) minmax(0, 1fr);
  align-items: center;
  gap: 9px;
  width: 100%;
  max-width: 100%;
  padding: 9px 10px;
  border: 1px solid color-mix(in srgb, var(--spectrum-card-accent) 68%, rgba(255, 255, 255, 0.35));
  border-radius: 6px;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.84), var(--spectrum-card-accent-wash)),
    rgba(251, 250, 246, 0.76);
  box-shadow:
    inset 0 0 22px var(--spectrum-card-accent-wash),
    0 6px 20px rgba(21, 21, 21, 0.03);
  overflow: hidden;
}

/* 谱系卡片箭头：详细卡保留右侧指示符，overview 小卡隐藏。 */
.spectrum-card::after {
  content: ">";
  position: absolute;
  right: 9px;
  top: 50%;
  color: var(--spectrum-card-accent-text);
  font-family: var(--font-latin);
  font-size: 19px;
  font-weight: 400;
  line-height: 1;
  opacity: 0.58;
  transform: translateY(-50%);
}

/* 概览卡片变体：只显示图案和中文标题，尺寸明显缩小。 */
.spectrum-card.is-overview {
  --spectrum-card-icon-size: 42px;
  min-height: 58px;
  padding: 7px 10px;
  gap: 8px;
}

/* 概览卡片箭头：概览树不需要可进入提示。 */
.spectrum-card.is-overview::after {
  display: none;
}

/* 大类卡片变体：比谱系卡略大，用于 detailed tree 中列。 */
.spectrum-card.is-class {
  --spectrum-card-icon-size: 66px;
  padding: 12px 14px;
}

/* 谱系小卡变体：固定高度以配合连接层坐标。 */
.spectrum-card.is-lineage {
  padding: 12px 14px;
}

/* 卡片图标圆框：黑色底圆固定，图标在圆心绝对居中。 */
.spectrum-card-icon {
  position: relative;
  display: grid;
  place-items: center;
  width: var(--spectrum-card-icon-size);
  height: var(--spectrum-card-icon-size);
  border: 1px solid rgba(45, 95, 150, 0.72);
  border-radius: 50%;
  background: #050505;
  overflow: visible;
}

/* 卡片图标图片：不单独缩小素材，只随圆框尺寸整体变化。 */
.spectrum-card-icon img {
  position: absolute;
  left: 50%;
  top: 50%;
  width: calc(var(--spectrum-card-icon-size) + 20px);
  height: calc(var(--spectrum-card-icon-size) + 20px);
  max-width: none;
  max-height: none;
  object-fit: contain;
  transform: translate(-50%, -50%);
}

/* 卡片文字列：预留箭头空间并防止长文本撑开布局。 */
.spectrum-card-copy {
  min-width: 0;
  padding-right: 10px;
}

/* 卡片中文标题：主题色跟随卡片变量，字号保持克制。 */
.spectrum-card-title {
  margin: 0;
  color: var(--spectrum-card-accent-text);
  font-size: 22px;
  font-weight: 900;
  line-height: 1.15;
  letter-spacing: 0;
  overflow-wrap: anywhere;
}

/* 概览卡片标题：小卡标题比详细正文略突出。 */
.spectrum-card.is-overview .spectrum-card-title {
  font-size: 18px;
}

/* 谱系卡标题：小卡标题统一高度节奏。 */
.spectrum-card.is-lineage .spectrum-card-title {
  font-size: 20px;
}

/* 卡片副标题：英文类别或谱系本质使用主题色。 */
.spectrum-card-subtitle {
  margin: 3px 0 0;
  color: var(--spectrum-card-accent-text);
  font-family: var(--font-latin);
  font-size: 12px;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: 0;
  overflow-wrap: anywhere;
}

/* 谱系卡副标题：中文“谱系本质”使用正文无衬线字体。 */
.spectrum-card.is-lineage .spectrum-card-subtitle {
  font-family: var(--font-sans);
  font-size: 16px;
}

/* 卡片描述：正文固定黑色，不跟随主题色变化。 */
.spectrum-card-description {
  margin: 6px 0 0;
  color: var(--color-ink);
  font-size: 16px;
  font-weight: 400;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

/* 详细树面板：为左侧核心、类别卡和谱系卡提供呼吸空间。 */
.spectrum-tree-panel {
  padding: clamp(28px, 3vw, 44px) clamp(24px, 3.2vw, 46px);
  overflow: visible;
}

/* 详细树画布：定义各列宽度，并允许宽屏继续向右展开。 */
.spectrum-tree {
  --spectrum-root-column: 156px;
  --spectrum-detail-card-width: clamp(270px, 27vw, 360px);
  --spectrum-connector-column: 100px;
  --spectrum-class-column: var(--spectrum-detail-card-width);
  --spectrum-lineage-card-width: var(--spectrum-detail-card-width);
  position: relative;
  width: fit-content;
  max-width: 100%;
  margin-inline: auto;
  min-width: 0;
  inline-size: fit-content;
  max-inline-size: 100%;
  min-inline-size: 0;
}

.spectrum-tree-groups {
  width: calc(
    var(--spectrum-root-column) +
    var(--spectrum-class-column) +
    var(--spectrum-connector-column) +
    var(--spectrum-lineage-card-width)
  );
}

/* 详细树 root SVG：画左侧 spine 和到三张大类卡的横线。 */
.spectrum-root-connector {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 1;
  width: var(--spectrum-root-column);
  height: var(--spectrum-tree-height);
  pointer-events: none;
}

/* 详细树核心图：旋转 malice-ball 覆盖在现实类卡片中点高度。 */
.spectrum-tree-root {
  position: absolute;
  left: 60px;
  top: var(--spectrum-root-core-y);
  z-index: 2;
  display: grid;
  place-items: center;
  width: clamp(210px, 20vw, 310px);
  aspect-ratio: 1;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.96) 0 34%, rgba(255, 255, 255, 0) 68%);
  opacity: 0.72;
  transform: translate(-50%, -50%) rotate(-90deg);
  pointer-events: none;
}

/* 详细树核心图片：保持素材完整显示，不参与布局宽度计算。 */
.spectrum-tree-root img {
  position: relative;
  z-index: 2;
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  filter: drop-shadow(0 10px 20px rgba(45, 95, 150, 0.12));
}

/* 详细树分组列：按 2/5/3 谱系堆叠，gap 与组件坐标一致。 */
.spectrum-tree-groups {
  position: relative;
  z-index: 3;
  display: grid;
  gap: var(--spectrum-group-gap);
}

/* 详细树单个大类组：让大类卡在本组总高度中点对齐。 */
.spectrum-tree-group {
  position: relative;
  display: grid;
  grid-template-columns:
    var(--spectrum-root-column)
    var(--spectrum-class-column)
    var(--spectrum-connector-column)
    minmax(0, var(--spectrum-lineage-card-width));
  align-items: center;
  height: var(--spectrum-group-height);
  min-width: 0;
}

/* 详细树大类卡列：位于左侧 root 连接线和右侧谱系分支之间。 */
.spectrum-tree-class {
  position: relative;
  z-index: 3;
  grid-column: 2;
  align-self: center;
  justify-self: stretch;
}

/* 详细树组内 SVG：统一绘制大类到谱系卡的横线、竖线和节点。 */
.spectrum-group-connector {
  position: absolute;
  left: calc(var(--spectrum-root-column) + var(--spectrum-class-column));
  top: 0;
  z-index: 2;
  width: var(--spectrum-connector-column);
  height: var(--spectrum-group-height);
  pointer-events: none;
}

/* 详细树谱系列：固定行高和行距，和 SVG 坐标逐行对应。 */
.spectrum-tree-lineages {
  grid-column: 4;
  display: grid;
  grid-template-rows: repeat(var(--lineage-count), var(--spectrum-detail-card-height));
  gap: var(--spectrum-lineage-gap);
  align-self: stretch;
  min-width: 0;
}

/* 详细树谱系行：只承载卡片，连接线由 SVG 层统一处理。 */
.spectrum-lineage-row {
  position: relative;
  display: block;
  min-width: 0;
}

/* 详细树谱系卡：高度锁定，保证所有连接端点对齐卡片中线。 */
.spectrum-tree-class > .spectrum-card,
.spectrum-lineage-row > .spectrum-card {
  height: var(--spectrum-detail-card-height);
}

/* 本页正文覆盖：避免 archive 正文样式给卡片段落加缩进。 */
.content-prose .spectrum-classification p {
  text-indent: 0;
}

/* 璇存槑妗嗘钀斤細鍦ㄦ湰椤靛叏灞€ p 閲嶇疆涔嬪悗锛屾仮澶嶄汉鐗╂杩扮殑鑷劧娈垫牸銆?*/
.content-prose .spectrum-classification .spectrum-overview-note .character-note-copy p {
  margin: 0 0 18px;
  max-width: 100%;
  text-indent: 2em;
}

/* 璇存槑妗嗘渶鍚庢钀斤細淇濇寔閲戣壊妗嗗唴鐨勬敹灏惧竷灞€銆?*/
.content-prose .spectrum-classification .spectrum-overview-note .character-note-copy p:last-child {
  margin-bottom: 0;
}

/* 中等宽度布局：缩小左移和卡列，保留完整树状结构。 */
@media (max-width: 1180px) {
  /* 中等宽度主容器：减少右移幅度，避免碰到视口边缘。 */
  .spectrum-classification {
    --spectrum-page-shift: clamp(34px, 4vw, 58px);
  }

  /* 中等宽度详细树：压缩类别卡和谱系卡宽度。 */
}

/* 窄屏布局：隐藏复杂连线，改为可读的单列谱系列表。 */
@media (max-width: 980px) {
  /* 窄屏主容器：取消桌面右移，使用视口内安全宽度。 */
  .spectrum-classification {
    width: 100%;
    max-width: 100%;
    margin-top: 20px;
    margin-left: 0;
    margin-right: auto;
    overflow-x: clip;
  }

  /* 窄屏面板：限制所有本页容器不超过视口宽度。 */
  .spectrum-overview-panel,
  .spectrum-overview-note,
  /* 窄屏概览画布：改成缩小版桌面树，避免左侧假树线随卡片宽度脱节。 */
  .spectrum-overview-map {
    display: block;
    min-height: 150px;
    padding: 0;
  }

  /* 窄屏概览树：使用绝对定位 SVG 和横排卡片，不再使用左侧 border 假树。 */
  .spectrum-overview-tree {
    position: relative;
    display: block;
    min-height: 150px;
    padding-left: 0;
    border-left: 0;
  }

  /* 窄屏概览连线：恢复横排 SVG 直角树。 */
  .spectrum-overview-connector.is-inline {
    display: block;
    height: 132px;
  }

  /* 窄屏概览双排连线：620px 以上保持隐藏。 */
  .spectrum-overview-connector.is-stacked {
    display: none;
  }

  /* 窄屏概览圆点层：跟随缩小 SVG 树显示端点。 */
  .spectrum-overview-dot-layer {
    display: block;
    height: 132px;
  }

  /* 窄屏概览根卡：恶能位于上方中心。 */
  .spectrum-overview-root {
    position: relative;
    z-index: 3;
    width: clamp(132px, 22vw, 170px);
    max-width: none;
    margin: 0 auto;
  }

  /* 窄屏概览根卡横线：由 SVG 接管。 */
  .spectrum-overview-root::before {
    content: none;
  }

  /* 窄屏概览类别：620px 以上三张横排。 */
  .spectrum-overview-classes {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: center;
    gap: 6px;
    width: 100%;
    margin-top: 44px;
  }

  /* 窄屏概览类别节点：小卡固定在各自列中心。 */
  .spectrum-overview-node {
    position: relative;
    width: min(100%, 112px);
    justify-self: center;
  }

  /* 窄屏概览类别横线：由 SVG 接管。 */
  .spectrum-overview-node::before {
    content: none;
  }

  /* 窄屏概览卡片：缩小图标和内边距，使三列能在宽屏移动端放下。 */
  .spectrum-overview-tree .spectrum-card {
    --spectrum-card-icon-size: clamp(28px, 5.2vw, 36px);
    min-height: 44px;
    padding: 6px 7px;
    gap: 5px;
  }

  /* 窄屏概览标题：控制字级，避免小卡撑开。 */
  .spectrum-overview-tree .spectrum-card-title {
    font-size: clamp(13px, 3.1vw, 16px);
  }

  .spectrum-tree-panel {
    width: 100%;
    max-width: 100%;
  }

  /* 窄屏概览面板：从横向树改为紧凑纵向内容。 */
  .spectrum-overview-panel {
    min-height: 0;
    padding: 18px 14px;
    overflow: visible;
  }

  /* 窄屏概览画布：取消桌面绝对连线所需的高度。 */
  .spectrum-overview-map {
    display: grid;
    gap: 10px;
    min-height: 0;
    padding: 0;
  }

  /* 窄屏概览树整体：移动端不做桌面下移。 */
  .spectrum-overview-tree {
    --spectrum-overview-tree-shift: 0px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    min-height: 0;
    padding-left: 12px;
    border-left: 1px solid var(--spectrum-line);
  }

  /* 窄屏概览连线：移动端隐藏复杂树线，优先保证阅读。 */
  .spectrum-overview-connector {
    display: none;
  }

  /* 窄屏概览圆点：移动端隐藏复杂树节点，避免悬浮错位。 */
  .spectrum-overview-dot-layer {
    display: none;
  }

  /* 窄屏概览核心底图：隐藏顶部装饰，避免压到单列卡片。 */
  .spectrum-overview-core-bg {
    display: none;
  }

  /* 窄屏概览小装饰：移动端不使用桌面的 overview 对齐装饰。 */
  .spectrum-overview-small-decor {
    display: none;
  }

  /* 窄屏概览 root 卡：与下方类别卡同宽居中。 */
  .spectrum-overview-root {
    position: relative;
    width: 100%;
    max-width: none;
    margin: 0;
  }

  /* 窄屏概览 root 横线：从左侧竖线接到“恶能”大卡中点。 */
  .spectrum-overview-root::before {
    content: "";
    position: absolute;
    left: -13px;
    top: 50%;
    width: 13px;
    height: 1px;
    background: var(--spectrum-line);
    transform: translateY(-50%);
    pointer-events: none;
  }

  /* 窄屏概览三类卡：改为单列堆叠。 */
  .spectrum-overview-classes {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    width: 86%;
    max-width: none;
    margin-top: 0;
  }

  /* 窄屏概览节点：所有小卡使用相同安全宽度。 */
  .spectrum-overview-node {
    position: relative;
    width: 100%;
    max-width: none;
  }

  /* 窄屏概览类别横线：从左侧竖线接到稍短的类别小卡中点。 */
  .spectrum-overview-node::before {
    content: "";
    position: absolute;
    left: clamp(-31px, -20vw, -80px);
    top: 50%;
    width: clamp(31px, 20vw, 80px);
    height: 1px;
    background: var(--spectrum-line);
    transform: translateY(-50%);
    pointer-events: none;
  }

  /* 窄屏概览卡片内部：复用详细树的文字列收口，避免横向裁切。 */
  .spectrum-overview-tree .spectrum-card {
    grid-template-columns: var(--spectrum-card-icon-size) minmax(0, calc(100% - var(--spectrum-card-icon-size) - 8px));
  }

  /* 窄屏概览文字列：强制使用卡片剩余宽度。 */
  .spectrum-overview-tree .spectrum-card-copy {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow: hidden;
  }

  /* 窄屏详细树面板：减小内边距让卡片有足够宽度。 */
  .spectrum-tree-panel {
    padding: 18px 14px;
  }

  /* 窄屏详细树画布：取消桌面 min-width，防止横向滚动。 */
  .spectrum-tree {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    inline-size: 100%;
    max-inline-size: 100%;
  }

  /* 窄屏详细树连接层：隐藏 SVG 和核心图，保留卡片层级。 */
  .spectrum-root-connector,
  .spectrum-tree-root,
  .spectrum-group-connector {
    display: none;
  }

  /* 窄屏详细树分组：减少组间距离。 */
  .spectrum-tree-groups {
    width: 100%;
    min-width: 0;
    gap: 20px;
  }

  /* 窄屏详细树单组：改为一列，并用左边线提示层级。 */
  .spectrum-tree-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    height: auto;
    padding-left: 12px;
    border-left: 1px solid var(--spectrum-line);
    min-width: 0;
  }

  /* 窄屏大类卡和谱系列：统一落入第一列。 */
  .spectrum-tree-class,
  .spectrum-tree-lineages {
    grid-column: 1;
    justify-self: center;
    min-width: 0;
  }

  /* 窄屏详细树大类卡：跟随面板可用宽度，保持单列居中。 */
  .spectrum-tree-class {
    position: relative;
    width: 100%;
    max-width: none;
  }

  /* 窄屏详细树大类横线：从左侧竖线接到大类卡中点。 */
  .spectrum-tree-class::before {
    content: "";
    position: absolute;
    left: -13px;
    top: 50%;
    width: 13px;
    height: 1px;
    background: var(--spectrum-line);
    transform: translateY(-50%);
    pointer-events: none;
  }

  /* 窄屏谱系列：取消固定行高，由内容自然撑开。 */
  .spectrum-tree-lineages {
    display: grid;
    grid-template-rows: none;
    gap: 10px;
    width: 86%;
    max-width: none;
    justify-self: center;
  }

  /* 窄屏谱系行：每行只显示一张卡片。 */
  .spectrum-lineage-row {
    position: relative;
    display: block;
    width: 100%;
    max-width: none;
  }

  /* 窄屏详细树谱系横线：从左侧竖线接到谱系小卡中点，形成假树状分支。 */
  .spectrum-lineage-row::before {
    content: "";
    position: absolute;
    left: -13px;
    top: 50%;
    width: 13px;
    height: 1px;
    background: var(--spectrum-line);
    transform: translateY(-50%);
    pointer-events: none;
  }

  /* 窄屏详细树文本：显式允许换行，避免继承 archive 正文的普通断行策略。 */
  .spectrum-tree .spectrum-card-title,
  .spectrum-tree .spectrum-card-subtitle,
  .spectrum-tree .spectrum-card-description {
    white-space: normal;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  /* 窄屏详细树卡片内部：图标列固定，文字列严格使用剩余宽度。 */
  .spectrum-tree .spectrum-card {
    grid-template-columns: var(--spectrum-card-icon-size) minmax(0, calc(100% - var(--spectrum-card-icon-size) - 9px));
  }

  /* 窄屏详细树文字列：阻止正文按内容宽度撑开卡片。 */
  .spectrum-tree .spectrum-card-copy {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow: hidden;
  }

  /* 窄屏谱系卡：高度恢复自适应，避免文字裁切。 */
  .spectrum-tree-class > .spectrum-card,
  .spectrum-lineage-row > .spectrum-card {
    height: auto;
  }

  /* 窄屏说明框文字：与卡片宽度保持一致。 */
  .spectrum-tree-lineages,
  .spectrum-lineage-row {
    width: 100%;
  }

  .spectrum-overview-note .character-note-copy,
  .spectrum-overview-note .character-note-copy p {
    max-width: none;
  }

  /* 窄屏概览最终覆盖：改成缩小版桌面 SVG 树，覆盖前面的纵向假树旧规则。 */
  .spectrum-overview-map {
    display: block;
    min-height: 150px;
    padding: 0;
  }

  /* 窄屏概览树最终覆盖：取消左侧假树线。 */
  .spectrum-overview-tree {
    position: relative;
    display: block;
    min-height: 150px;
    padding-left: 0;
    border-left: 0;
  }

  /* 窄屏概览横排 SVG：620px 以上显示。 */
  .spectrum-overview-connector.is-inline {
    display: block;
    height: 132px;
  }

  /* 窄屏概览双排 SVG：620px 以上隐藏。 */
  .spectrum-overview-connector.is-stacked {
    display: none;
  }

  /* 窄屏概览圆点层：恢复显示。 */
  .spectrum-overview-dot-layer {
    display: block;
    height: 132px;
  }

