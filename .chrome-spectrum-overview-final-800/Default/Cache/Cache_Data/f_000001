  }

  /* 手机概览横排连线：切换到双排 SVG。 */
  .spectrum-overview-connector.is-inline {
    display: none;
  }

  /* 手机概览双排连线：左上、右上、中下三个类别节点。 */
  .spectrum-overview-connector.is-stacked {
    display: block;
    height: 220px;
  }

  /* 手机概览圆点层：匹配双排 SVG 的几何点。 */
  .spectrum-overview-dot-layer {
    height: 220px;
  }

  /* 手机概览根节点：保持在双排树顶部中心。 */
  .spectrum-overview-root {
    width: clamp(132px, 38vw, 150px);
  }

