---
import "../../styles/content/gallery-interaction.css";

const {
  galleryId,
  galleryLabel = "打开图片图集",
  galleryBadge = "/icon/picture.png",
  variant = "default",
} = Astro.props;

const hasGallery = typeof galleryId === "string" && galleryId.length > 0;
const isFigure = variant === "figure";
---

{hasGallery && (
  <div class:list={["content-frame-icon-interaction", isFigure && "is-figure"]}>
    <button
      class="content-frame-gallery-trigger"
      type="button"
      aria-label={galleryLabel}
      data-gallery-open={galleryId}
    ></button>
    <span class="content-frame-gallery-badge" aria-hidden="true">
      <img src={galleryBadge} alt="" />
    </span>
  </div>
)}
