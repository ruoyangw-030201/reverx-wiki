---
import "../../styles/content/content-frame-icon-frame.css";

const {
  icon,
  iconAlt = "",
  caption,
  items,
  variant = "default",
  showJunction = true,
} = Astro.props;

const iconItems = Array.isArray(items)
  ? items
  : icon
    ? [{ icon, iconAlt, caption }]
    : [];

const originalOnlyBigIcons = new Set([
  "/big-icon/rattown.webp",
  "/big-icon/shalom.webp",
  "/big-icon/taran.webp",
  "/big-icon/sarra.webp",
]);

function resolveFrameIcon(iconPath) {
  if (typeof iconPath !== "string") return iconPath;
  if (originalOnlyBigIcons.has(iconPath)) return iconPath;
  if (iconPath.startsWith("/big-icon/") && iconPath.endsWith(".webp")) {
    return iconPath.replace("/big-icon/", "/big-icon-dark/");
  }
  if (iconPath.startsWith("/icon/") && iconPath.endsWith(".png")) {
    return iconPath.replace("/icon/", "/icon-dark/");
  }
  return iconPath;
}

const displayIconItems = iconItems.map((item) => ({
  ...item,
  icon: resolveFrameIcon(item.icon),
}));

const isExtended = variant === "extended";
const isFigure = variant === "figure";
const iconFrameHeight = isExtended
  ? `${Math.max(352, 120 + iconItems.length * 132)}px`
  : undefined;
---

<div
  class:list={[
    "content-frame-icon-stack",
    isExtended && "is-extended",
    isFigure && "is-figure",
  ]}
  style={iconFrameHeight ? `--content-frame-icon-slot-height: ${iconFrameHeight};` : undefined}
  aria-hidden="true"
>
  <span class="content-frame-icon-box content-frame-icon-box-main"></span>
  <span class="content-frame-icon-box content-frame-icon-box-inner"></span>
  {showJunction && (
    <>
      <span class="content-frame-icon-junction content-frame-icon-junction-top">
        <img src="/texture/texture-13.png" alt="" />
      </span>
      <span class="content-frame-icon-junction content-frame-icon-junction-bottom">
        <span></span>
      </span>
    </>
  )}
  {iconItems.length > 0 && (
    <span
      class:list={[
        "content-frame-icon-media",
        iconItems.length > 1 && "is-multiple",
        isFigure && "is-figure",
      ]}
    >
      {displayIconItems.map((item) => (
        <span class="content-frame-icon-item">
          <img class="content-frame-icon-image" src={item.icon} alt={item.iconAlt ?? ""} />
          {item.caption && <span class="content-frame-icon-caption">{item.caption}</span>}
        </span>
      ))}
    </span>
  )}
</div>
