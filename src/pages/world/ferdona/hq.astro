---
import ArchiveEntryHeading from "../../../components/ArchiveEntryHeading.astro";
import ArchiveHeadingSideIcon from "../../../components/ArchiveHeadingSideIcon.astro";
import ContentFrame from "../../../components/content-frame/ContentFrame.astro";
import ContentFrameBox from "../../../components/content-frame/ContentFrameBox.astro";
import ContentFrameIconFrame from "../../../components/content-frame/ContentFrameIconFrame.astro";
import { resolveWorldEntity } from "../../../data/worldEntities.js";
import ArchiveLayout from "../../../layouts/ArchiveLayout.astro";

const hq = resolveWorldEntity("hq");
const shalom = resolveWorldEntity("shalom");
const rattown = resolveWorldEntity("rattown");
const taran = resolveWorldEntity("taran");
const sarra = resolveWorldEntity("sarra");
const contech = resolveWorldEntity("contech");
const ida = resolveWorldEntity("ida");
---

<ArchiveLayout contentMode="custom">
  <ContentFrame icon={hq.icon} iconAlt={hq.label}>
    <p>
      由「开洞计划」的“创立者们”建设的、政府承认的官方恶能者社会，不为普通人所知，仅收容恶能者们于基地中生活，登记在册的总恶能者约26万人。主要有舍拉姆、莱城、塔兰三大基地和数个小基地，隐秘分布于各个州中。上设主席，上议会（又称创立者议会），下议会。主要辖地为凡多纳东、北部。
    </p>
    <p>
      在基地中，恶能者社会如正常社会一般运行。能力出众者可以进入「猎魔者」小队中，进行消灭魔物的战斗。
    </p>
  </ContentFrame>

  <ArchiveEntryHeading id="shalom-base" variant="secondary" title={shalom.label} subtitle={shalom.labelEn} anchorName="--shalom-base-heading" />
  <ArchiveHeadingSideIcon icon="/big-icon-dark/shalom-base.webp" anchorName="--shalom-base-heading" />
  <ContentFrameBox>
    <Fragment slot="measure">
      <ContentFrameIconFrame icon="/big-icon/shalom.webp" />
    </Fragment>

    <p>
      管理东北部比乐吉等五州的恶能者基地，位置处于比乐吉州。
    </p>
    <p>
      是移民以来凡多纳恶能者与世隔绝的聚居小镇，人口约5万人。1692年，名为“女巫”的魔物肆虐了这里，留下了后世的审判案。这里是大多数“创立者们”的家乡，改建为最早的三大基地之一。建筑呈现出典型的小镇风格。
    </p>
  </ContentFrameBox>

  <ArchiveEntryHeading id="rattown-base" variant="secondary" title={rattown.label} subtitle={rattown.labelEn} anchorName="--rattown-base-heading" />
  <ArchiveHeadingSideIcon icon="/big-icon-dark/rattown-base.webp" anchorName="--rattown-base-heading" />
  <ContentFrameBox>
    <Fragment slot="measure">
      <ContentFrameIconFrame icon="/big-icon/rattown.webp" />
    </Fragment>

    <p>
      管理华斯特兰等中部四州的恶能者基地，位置处于华斯特兰州，即平行世界的密歇根州。
    </p>
    <p>
      是现恶能者世界的总部政府所在地和行政中心，人口众多，约11万人。基地建筑呈现出重工业风格。
    </p>
  </ContentFrameBox>

  <ArchiveEntryHeading id="taran-base" variant="secondary" title={taran.label} subtitle={taran.labelEn} anchorName="--taran-base-heading" />
  <ArchiveHeadingSideIcon icon="/big-icon-dark/taran-base.webp" anchorName="--taran-base-heading" />
  <ContentFrameBox>
    <Fragment slot="measure">
      <ContentFrameIconFrame icon="/big-icon/taran.webp" />
    </Fragment>

    <p>
      管理北部林恩和卢瑞菲尔德二州的恶能者基地，位置处于林恩州，即平行世界的加拿大安大略省（在此并入凡多纳）。人口约3万人。主角西奥多·维杰所属组织。
    </p>
    <p>
      建造时间晚于前两个基地，因而呈现出现代化感。
    </p>
  </ContentFrameBox>

  <ArchiveEntryHeading id="sarra-base" variant="secondary" title={sarra.label} subtitle={sarra.labelEn} anchorName="--sarra-base-heading" />
  <ArchiveHeadingSideIcon icon="/big-icon-dark/sarra-base.webp" anchorName="--sarra-base-heading" />
  <ContentFrameBox>
    <Fragment slot="measure">
      <ContentFrameIconFrame icon="/big-icon/sarra.webp" />
    </Fragment>

    <p>
      位于卡瑟州并管理该州官方恶能者的基地，人口不超过1万人。由于卡瑟州大部分恶能者都由希景公司控制，是总部面对希景公司的前哨阵地。
    </p>
  </ContentFrameBox>

  <ArchiveEntryHeading id="contech" variant="secondary" title={contech.label} subtitle={contech.labelEn} />
  <ContentFrameBox>
    <Fragment slot="measure">
      <ContentFrameIconFrame icon={contech.icon} />
    </Fragment>

    <p>
      总部为对抗希景成立的科技公司，主要发展与恶能能量相关的前沿技术。总部官方武器供应。位于莱城基地，在塔兰基地有守恒-塔兰分部。
    </p>
  </ContentFrameBox>

  <ArchiveEntryHeading id="ida" variant="secondary" title={ida.label} subtitle={ida.labelEn} />
  <ContentFrameBox>
    <Fragment slot="measure">
      <ContentFrameIconFrame icon={ida.icon} />
    </Fragment>

    <p>
      致力于寻找拥有「解构级」能力的恶能者的协会。主办IDA峰会，是总部和其他势力交流的平台。同样发行军火武器，与守恒科技一起构成总部的武器部。
    </p>
  </ContentFrameBox>
</ArchiveLayout>
