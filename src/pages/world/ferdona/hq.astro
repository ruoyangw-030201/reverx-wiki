---
import EntryHeading from "../../../components/primitives/EntryHeading.astro";
import ArchiveInfoCardList from "../../../components/content/ArchiveInfoCardList.astro";
import ContentFrame from "../../../components/content-frame/ContentFrame.astro";
import ContentFrameBox from "../../../components/content-frame/ContentFrameBox.astro";
import ContentFrameIconFrame from "../../../components/content-frame/ContentFrameIconFrame.astro";
import { resolveWorldEntity } from "../../../data/worldEntities.js";
import ArchiveLayout from "../../../layouts/ArchiveLayout.astro";

const hq = resolveWorldEntity("hq");
const shalom = resolveWorldEntity("shalom");
const rattown = resolveWorldEntity("rattown");
const taran = resolveWorldEntity("taran");
const sarra = resolveWorldEntity("sarra");
const contech = resolveWorldEntity("contech");
const ida = resolveWorldEntity("ida");

const hqInfoCards = [
  { heading: "创立时间", icon: "/icon-dark/reality.png", title: "2010年", },
  { heading: "组织性质", icon: "/big-icon-dark/hq.webp", title: "恶能者收容机构", description: "官方组织" },
  { heading: "创立者", icon: "/icon-dark/human.png", title: "“创立者们”", },
];
const shalomInfoCards = [
  { heading: "创立时间", icon: "/icon-dark/reality.png", title: "2010年", },
  { heading: "组织性质", icon: "/big-icon-dark/shalom-base.webp", title: "恶能者收容机构", description: "官方组织" },
  { heading: "创立者", icon: "/icon-dark/human.png", title: "“创立者们”", },
];
const rattownInfoCards = [
  { heading: "创立时间", icon: "/icon-dark/reality.png", title: "2010年", },
  { heading: "组织性质", icon: "/big-icon-dark/rattown-base.webp", title: "恶能者收容机构", description: "官方组织" },
  { heading: "创立者", icon: "/icon-dark/human.png", title: "“创立者们”", },
];
const taranInfoCards = [
  { heading: "创立时间", icon: "/icon-dark/reality.png", title: "2022年", },
  { heading: "组织性质", icon: "/big-icon-dark/taran-base.webp", title: "恶能者收容机构", description: "官方组织" },
  { heading: "创立者", icon: "/icon-dark/human.png", title: "托万·汉密尔顿", },
];
const sarraInfoCards = [
  { heading: "创立时间", icon: "/icon-dark/reality.png", title: "2011年", },
  { heading: "组织性质", icon: "/big-icon-dark/taran-base.webp", title: "恶能者收容机构", description: "官方组织" },
  { heading: "创立者", icon: "/icon-dark/human.png", title: "安·格林薇尔", },
];
const contechInfoCards = [
  { heading: "创立时间", icon: "/icon-dark/reality.png", title: "2012年", },
  { heading: "组织性质", icon: "/big-icon-dark/contech.webp", title: "公司", description: "官方合作组织" },
  { heading: "创立者", icon: "/icon-dark/human.png", title: "赫斯提亚·芬尼克", },
];
const idaInfoCards = [
  { heading: "创立时间", icon: "/icon-dark/reality.png", title: "2028年", },
  { heading: "组织性质", icon: "/big-icon-dark/ida.webp", title: "公司，协会", description: "官方合作组织" },
  { heading: "创立者", icon: "/icon-dark/human.png", title: "利亚德·帕克", },
];
---

<ArchiveLayout contentMode="custom">
  <ContentFrame icon={hq.icon} iconAlt={hq.label}>
    <ArchiveInfoCardList items={hqInfoCards} />
    <p>
      由「开洞计划」的“创立者们”建设的、政府承认的官方恶能者社会，不为普通人所知，仅收容恶能者们于基地中生活，登记在册的总恶能者约26万人。主要有舍拉姆、莱城、塔兰三大基地和数个小基地，隐秘分布于各个州中。上设主席，上议会（又称创立者议会），下议会。主要辖地为凡多纳东、北部。
    </p>
    <p>
      在基地中，恶能者社会如正常社会一般运行。能力出众者可以进入「猎魔者」小队中，进行消灭魔物的战斗。
    </p>
  </ContentFrame>

  <EntryHeading id="shalom-base" variant="secondary" title={shalom.label} subtitle={shalom.labelEn} />
  <ContentFrameBox>
    <Fragment slot="measure">
      <ContentFrameIconFrame icon="/big-icon/shalom.webp" />
    </Fragment>

    <ArchiveInfoCardList items={shalomInfoCards} />
    <p>
      管理东北部比乐吉等五州的恶能者基地，位置处于比乐吉州。
    </p>
    <p>
      是移民以来凡多纳恶能者与世隔绝的聚居小镇，人口约5万人。1692年，名为“女巫”的魔物肆虐了这里，留下了后世的审判案。这里是大多数“创立者们”的家乡，改建为最早的三大基地之一。建筑呈现出典型的小镇风格。
    </p>
  </ContentFrameBox>

  <EntryHeading id="rattown-base" variant="secondary" title={rattown.label} subtitle={rattown.labelEn} />
  <ContentFrameBox>
    <Fragment slot="measure">
      <ContentFrameIconFrame icon="/big-icon/rattown.webp" />
    </Fragment>

    <ArchiveInfoCardList items={rattownInfoCards} />
    <p>
      管理华斯特兰等中部四州的恶能者基地，位置处于华斯特兰州，即平行世界的密歇根州。
    </p>
    <p>
      是现恶能者世界的总部政府所在地和行政中心，人口众多，约11万人。基地建筑呈现出重工业风格。
    </p>
  </ContentFrameBox>

  <EntryHeading id="taran-base" variant="secondary" title={taran.label} subtitle={taran.labelEn} />
  <ContentFrameBox>
    <Fragment slot="measure">
      <ContentFrameIconFrame icon="/big-icon/taran.webp" />
    </Fragment>

    <ArchiveInfoCardList items={taranInfoCards} />
    <p>
      管理北部林恩和卢瑞菲尔德二州的恶能者基地，位置处于林恩州，即平行世界的加拿大安大略省（在此并入凡多纳）。人口约3万人。主角西奥多·维杰所属组织。
    </p>
    <p>
      建造时间晚于前两个基地，因而呈现出现代化感。
    </p>
  </ContentFrameBox>

  <EntryHeading id="sarra-base" variant="secondary" title={sarra.label} subtitle={sarra.labelEn} />
  <ContentFrameBox>
    <Fragment slot="measure">
      <ContentFrameIconFrame icon="/big-icon/sarra.webp" />
    </Fragment>

    <ArchiveInfoCardList items={sarraInfoCards} />
    <p>
      位于卡瑟州并管理该州官方恶能者的基地，人口不超过1万人。由于卡瑟州大部分恶能者都由希景公司控制，是总部面对希景公司的前哨阵地。
    </p>
  </ContentFrameBox>

  <EntryHeading id="contech" variant="secondary" title={contech.label} subtitle={contech.labelEn} />
  <ContentFrameBox>
    <Fragment slot="measure">
      <ContentFrameIconFrame icon={contech.icon} />
    </Fragment>

    <ArchiveInfoCardList items={contechInfoCards} />
    <p>
      为对抗希景公司，总部曾成立公立的科技与发展团队，后因权力斗争分裂为多家商业公司。守恒科技是其最大的遗产，作为一家科技公司，主要发展与恶能能量相关的前沿技术。
    </p>
    <p>
      目前是总部官方武器和民用科技供应商。
    </p>
    <p>
      位于莱城基地，在塔兰基地有守恒-塔兰分部。
    </p>
  </ContentFrameBox>

  <EntryHeading id="ida" variant="secondary" title={ida.label} subtitle={ida.labelEn} />
  <ContentFrameBox>
    <Fragment slot="measure">
      <ContentFrameIconFrame icon={ida.icon} />
    </Fragment>

    <ArchiveInfoCardList items={idaInfoCards} />
    <p>
      致力于寻找拥有「解构级」能力的恶能者的协会。主办IDA峰会，是总部和其他势力交流的平台。同样发行军火武器，与守恒科技一起构成总部的武器部。
    </p>
  </ContentFrameBox>
</ArchiveLayout>
