---
import IconCard from "../../components/actions/IconCard.astro";
import IconList from "../../components/actions/IconList.astro";
import IndexGrid from "../../components/index/IndexGrid.astro";
import MapCard from "../../components/actions/MapCard.astro";
import IndexSection from "../../components/index/IndexSection.astro";
import IndexLayout from "../../layouts/IndexLayout.astro";
import { getRequiredIndexPageEntry, renderContentEntry } from "../../data/intro/entries.js";
import { getSidebarItemsForPath } from "../../data/navigation.js";
import { worldMaps } from "../../data/world/maps.js";

const entry = await getRequiredIndexPageEntry("world");
const { Content } = await renderContentEntry(entry);

const worldSidebarGroups = [];

for (const item of getSidebarItemsForPath("/world")) {
  if (item.type === "group") {
    worldSidebarGroups.push({ heading: item, items: [] });
    continue;
  }

  worldSidebarGroups.at(-1)?.items.push(item);
}

const findEntityGroupItems = (entityKey) =>
  worldSidebarGroups.find((group) => group.heading.entityKey === entityKey)?.items ?? [];
const findKeyGroupItems = (key) =>
  worldSidebarGroups.find((group) => group.heading.key === key)?.items ?? [];

const getIconGroupItems = (groupKey) =>
  findEntityGroupItems(groupKey).length > 0
    ? findEntityGroupItems(groupKey)
    : findKeyGroupItems(groupKey);
---

<IndexLayout>
  <Fragment slot="intro">
    <Content />
  </Fragment>

  <IndexGrid class={entry.data.gridClass} label={entry.data.gridLabel}>
    {entry.data.sections.map((section) => (
      <IndexSection
        layout={section.layout}
        title={section.title}
        subtitle={section.subtitle}
        description={section.description}
      >
        <div class="world-index-section-flow">
          {section.mapKey && (
            <MapCard
              href={worldMaps[section.mapKey].href}
              src={worldMaps[section.mapKey].image}
              alt={`${worldMaps[section.mapKey].title}地图`}
            />
          )}
          <IconList class="world-index-section-icons">
            {getIconGroupItems(section.iconGroup).map((entity) => (
              <IconCard href={entity.href} icon={entity.icon} caption={entity.label} alt={`${entity.label}图标`} />
            ))}
          </IconList>
        </div>
      </IndexSection>
    ))}
  </IndexGrid>
</IndexLayout>
