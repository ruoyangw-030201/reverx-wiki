---
import ChromeLayout from "../../layouts/ChromeLayout.astro";
import ContentBox from "../../components/content-frame/ContentBox.astro";
import EntryHeading from "../../components/primitives/EntryHeading.astro";
import "../../styles/content-frame/simple-test.css";
---

<ChromeLayout
  pageClass={["archive-page", "is-history", "is-simple-test"]}
  showHero={false}
  showSidebar={false}
>
  <section class="simple-test-frame">
    <EntryHeading
      kicker="INDEX"
      title="世界概览"
      subtitle="WORLD"
    />

    <ContentBox class="simple-test-box" variant="simple">
      <p>
        本概览介绍的世界建立在现实的平行世界基础之上。由于海平面相较现实略有下降，陆地版图发生了细微变化，也推动历史进程走向了不同的分支。同样，因为恶能——这种超能力的存在，诞生了隐秘的恶能者势力。本标签主要介绍该世界的现代地理格局、主要势力分布与宗教体系。
      </p>
      <p>
        接下来，可以点击下方地图，先获得对世界版图与区域关系的直观印象；或者直接点击各个势力，了解这个世界。
      </p>
    </ContentBox>
  </section>
</ChromeLayout>
