---
import IconCard from "../../components/actions/IconCard.astro";
import IconList from "../../components/actions/IconList.astro";
import IndexGrid from "../../components/index/IndexGrid.astro";
import IndexSection from "../../components/index/IndexSection.astro";
import IndexLayout from "../../layouts/IndexLayout.astro";
import { getRequiredIndexPageEntry, renderContentEntry } from "../../data/intro/entries.js";
import { characterGroups } from "../../data/navigation.js";

const entry = await getRequiredIndexPageEntry("characters");
const { Content } = await renderContentEntry(entry);
---

<IndexLayout>
  <Fragment slot="intro">
    <Content />
  </Fragment>

  <IndexGrid label={entry.data.gridLabel}>
    {characterGroups.map((group) => (
      <IndexSection title={group.label} subtitle={group.labelEn}>
        {group.items.length > 0 && (
          <IconList>
            {group.items.map((character) => (
              <IconCard
                href={character.href}
                icon={character.indexIcon}
                caption={character.label}
                alt={`${character.label}人物图标`}
                variant="light"
              />
            ))}
          </IconList>
        )}
      </IndexSection>
    ))}
  </IndexGrid>
</IndexLayout>
