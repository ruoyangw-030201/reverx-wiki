---
import IndexIconCard from "../../components/index/IndexIconCard.astro";
import IndexSection from "../../components/index/IndexSection.astro";
import IndexLayout from "../../layouts/IndexLayout.astro";
---

<IndexLayout>
  <div slot="intro" class="archive-index-intro-copy">
    <p>
      本标签收录了主要角色档案，包括人物身份、所属势力、能力设定等。
    </p>
    <p>
      接下来，可以点击下方的人物头像，了解角色档案。
    </p>
  </div>

  <section class="characters-index-grid" aria-label="角色档案分区">
    <IndexSection title="总部势力" subtitle="HQ">
      <div class="index-icon-list">
        <IndexIconCard href="/characters/theodore" icon="/figure-icon/theodore.png" caption="西奥多·维杰" alt="西奥多·维杰人物图标" />
        <IndexIconCard href="/characters/ornette" icon="/figure-icon/ornette.png" caption="欧奈特·帕克" alt="欧奈特·帕克人物图标" />
      </div>
    </IndexSection>

    <IndexSection title="希景势力" subtitle="Prospect">
      <div class="index-icon-list">
        <IndexIconCard href="/characters/santino" icon="/figure-icon/santino.png" caption="桑蒂诺·埃梅特" alt="桑蒂诺·埃梅特人物图标" />
        <IndexIconCard href="/characters/fraser" icon="/figure-icon/fraser.png" caption="弗雷泽·B." alt="弗雷泽·B.人物图标" />
      </div>
    </IndexSection>

    <IndexSection title="小屋势力" subtitle="Cabin" />

    <IndexSection title="其他凡多纳势力" subtitle="Others in Ferdona" />

    <IndexSection title="海西势力" subtitle="Hespera">
      <div class="index-icon-list">
        <IndexIconCard href="/characters/liat" icon="/figure-icon/liat.png" caption="利亚德·帕克" alt="利亚德·帕克人物图标" />
        <IndexIconCard href="/characters/jonathan" icon="/figure-icon/jonathan.png" caption="乔纳森·卡齐尔" alt="乔纳森·卡齐尔人物图标" />
      </div>
    </IndexSection>

    <IndexSection title="魔物与其他" subtitle="Malit & Others" />
  </section>
</IndexLayout>
