---
import IndexIconCard from "../../components/index/IndexIconCard.astro";
import IndexSection from "../../components/index/IndexSection.astro";
import IndexLayout from "../../layouts/IndexLayout.astro";
import { characterGroups } from "../../data/navigation.js";
---

<IndexLayout>
  <div slot="intro" class="archive-index-intro-copy">
    <p>
      本标签收录了主要角色档案，包括人物身份、所属势力、能力设定等。
    </p>
    <p>
      接下来，可以点击下方的人物头像，了解角色档案。
    </p>
  </div>

  <section class="characters-index-grid" aria-label="角色档案分区">
    {characterGroups.map((group) => (
      <IndexSection title={group.label} subtitle={group.labelEn}>
        {group.items.length > 0 && (
          <div class="index-icon-list">
            {group.items.map((character) => (
              <IndexIconCard
                href={character.href}
                icon={character.indexIcon}
                caption={character.label}
                alt={`${character.label}人物图标`}
              />
            ))}
          </div>
        )}
      </IndexSection>
    ))}
  </section>
</IndexLayout>
