---
import IconCard from "../../components/actions/IconCard.astro";
import IconList from "../../components/actions/IconList.astro";
import IndexGrid from "../../components/index/IndexGrid.astro";
import IndexSection from "../../components/index/IndexSection.astro";
import IndexLayout from "../../layouts/IndexLayout.astro";
import { getRequiredIndexPageEntry, renderContentEntry } from "../../data/intro/entries.js";
import { getSidebarItemsForPath } from "../../data/navigation.js";

const entry = await getRequiredIndexPageEntry("system");
const { Content } = await renderContentEntry(entry);
const systemItemsByHref = new Map(
  getSidebarItemsForPath("/system").map((item) => [item.href, item])
);

const resolveSystemIndexItems = (hrefs) =>
  hrefs.map((href) => systemItemsByHref.get(href)).filter(Boolean);
---

<IndexLayout>
  <Fragment slot="intro">
    <Content />
  </Fragment>

  <IndexGrid layout={entry.data.gridLayout} label={entry.data.gridLabel}>
    {entry.data.sections.map((group) => (
      <IndexSection title={group.title} subtitle={group.subtitle}>
        <IconList>
          {resolveSystemIndexItems(group.hrefs ?? []).map((item) => (
            <IconCard
              href={item.href}
              icon={item.icon}
              caption={item.label}
              alt={`${item.label}图标`}
            />
          ))}
        </IconList>
      </IndexSection>
    ))}
  </IndexGrid>
</IndexLayout>
