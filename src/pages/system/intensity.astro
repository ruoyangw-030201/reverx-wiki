---
import ArchiveShellLayout from "../../layouts/ArchiveShellLayout.astro";
import IntensityDiagram from "../../components/system/intensity/IntensityDiagram.astro";

const placeholderIcons = {
  class: "/icon/reality.png",
  capacity: "/icon/field.png",
  basic: "/icon/basic-rank.png",
  energy: "/icon/energy-rank.png",
  semi: "/icon/half-decon-rank.png",
  dismantle: "/icon/decon-rank.png",
  overlimit: "/icon/super-rank.png",
  hunterJr: "/icon/malit-hunter.png",
  hunterSr: "/icon-dark/malit-hunter.png",
  hunterD: "/icon-dark/malit-hunter-2.png",
  monsterLow: "/icon/malit.png",
  monsterMid: "/icon-dark/malit.png",
  monsterHigh: "/icon-dark/malit-2.png",
  unknown: "/icon/unknown.png",
};

const classRows = [
  {
    icon: placeholderIcons.basic,
    title: "基础级",
    description: "可以使用武器造成“物理伤害”",
  },
  {
    icon: placeholderIcons.energy,
    title: "能量级",
    description: "可以使用武器释放能量、信息",
  },
  {
    icon: placeholderIcons.semi,
    title: "半解构级",
    description: "可以给武器附魔使用，比能量级破坏性更强",
  },
  {
    icon: placeholderIcons.dismantle,
    title: "解构级",
    description: "可以不依托武器，直接徒手使用能力，自由度大幅提升",
  },
  {
    icon: placeholderIcons.overlimit,
    title: "超限级",
    description: "开始触及谱系本质，发展出自身独特的概念",
  },
];

const dangerRows = [
  {
    grade: "JR",
    gradeClass: "jr",
    title: "猎魔者专属危险等级；注册猎魔者",
    description: "新晋猎魔者，具备基础作战资格。",
    hunterIcon: placeholderIcons.hunterJr,
    monsterMark: "/",
    monsterAlt: "无魔物评级",
  },
  {
    grade: "SR",
    gradeClass: "sr",
    title: "猎魔者专属危险等级；资深猎魔者",
    description: "资深猎魔者，可处理常规事件。",
    hunterIcon: placeholderIcons.hunterSr,
    monsterMark: "/",
    monsterAlt: "无魔物评级",
  },
  {
    grade: "D1",
    gradeClass: "d1",
    title: "可正面击溃一支普通武装小队",
    description: "【从此等级起为猎魔者与魔物共用评级】威胁一般，需专业人员应对。",
    hunterIcon: placeholderIcons.hunterD,
    monsterIcon: placeholderIcons.monsterLow,
  },
  {
    grade: "D2",
    gradeClass: "d2",
    title: "可压制或歼灭多支普通武装小队；在封闭区域形成绝对优势",
    description: "威胁上升，需专业小队级战术处置。",
    hunterIcon: placeholderIcons.hunterD,
    monsterIcon: placeholderIcons.monsterLow,
  },
  {
    grade: "D3",
    gradeClass: "d3",
    title: "可控制或摧毁一个街区；明显破坏普通社会秩序",
    description: "威胁较高，需封锁与疏散。",
    hunterIcon: placeholderIcons.hunterD,
    monsterIcon: placeholderIcons.monsterMid,
  },
  {
    grade: "D4",
    gradeClass: "d4",
    title: "可控制或摧毁一个城区；对设施和人群造成大规模破坏",
    description: "威胁高，需区域应急。",
    hunterIcon: placeholderIcons.hunterD,
    monsterIcon: placeholderIcons.monsterMid,
  },
  {
    grade: "D5",
    gradeClass: "d5",
    title: "可控制或摧毁整座城市",
    description: "威胁极高，需城市级响应。",
    hunterIcon: placeholderIcons.hunterD,
    monsterIcon: placeholderIcons.monsterHigh,
  },
  {
    grade: "D6",
    gradeClass: "d6",
    title: "能力范围可影响州、省级区域大小",
    description: "危机，需跨州/省联合统筹。",
    hunterIcon: placeholderIcons.hunterD,
    monsterIcon: placeholderIcons.monsterHigh,
  },
  {
    grade: "...",
    code: "",
    gradeClass: "unknown",
    title: "尚不明确",
    description: "尚不明确",
    hunterIcon: placeholderIcons.unknown,
    monsterIcon: placeholderIcons.unknown,
  },
];

const classCard = {
  title: "品阶",
  subtitle: "CLASS",
  lead: "品阶代表能力所处的层级，通常来说是天生的。",
  titleIcon: placeholderIcons.class,
  rows: classRows,
};

const capacityCard = {
  title: "容积",
  subtitle: "CAPACITY",
  lead: [
    "容积就是恶能者、魔物自身“场”的大小，本质上就是蓝条。",
    "场越大、场中的粒子密度更高，总能量就越多（蓝条就越长）。",
  ],
  titleIcon: placeholderIcons.capacity,
  texture: "/texture/capacity.svg",
};

const core = {
  title: "强度 = 品阶 × 容积",
  roundTexture: "/texture/round_round.svg",
  radiantTexture: "/texture/round_radiant.svg",
};

const badge = {
  title: "危险等级",
  subtitle: "D-RANK",
  description: "描述最终破坏规模",
};
---

<ArchiveShellLayout pageClass="system-intensity-page" showHeading showStandaloneNextLink>
  <IntensityDiagram
    classCard={classCard}
    capacityCard={capacityCard}
    core={core}
    badge={badge}
    dangerRows={dangerRows}
  />
</ArchiveShellLayout>
