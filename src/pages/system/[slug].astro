---
import { getCollection } from "astro:content";
import ArchiveContentRenderer from "../../components/archive/ArchiveContentRenderer.astro";
import ArchiveDefaultLayout from "../../layouts/ArchiveDefaultLayout.astro";
import ArchiveSecretLayout from "../../layouts/ArchiveSecretLayout.astro";
import { getArchiveEntryContext } from "../../data/archive/entryContext.js";

export async function getStaticPaths() {
  const entries = await getCollection("archive", (entry) => entry.data.section === "system");

  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/^system\//, "") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const archive = getArchiveEntryContext(Astro.url.pathname);
const Layout = entry.data.layout === "secret" ? ArchiveSecretLayout : ArchiveDefaultLayout;
---

<Layout archive={archive}>
  <ArchiveContentRenderer archive={archive} entry={entry.data} />
</Layout>
