---
import { getEntry, render } from "astro:content";
import ArchiveShellLayout from "../../layouts/ArchiveShellLayout.astro";
import ClassificationLayout from "../../components/system/classification/ClassificationLayout.astro";

const entry = await getEntry("systemSpecial", "classification");

if (!entry) {
  throw new Error("Missing system-special classification content.");
}

const { Content } = await render(entry);
---

<ArchiveShellLayout pageClass="system-classification-page" showHeading showStandaloneNextLink>
  <ClassificationLayout>
    <Fragment slot="note">
      <Content />
    </Fragment>
  </ClassificationLayout>
</ArchiveShellLayout>
