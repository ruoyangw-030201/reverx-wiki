---
import ContentFrame from "../../components/content-frame/ContentFrame.astro";
import ArchiveLayout from "../../layouts/ArchiveLayout.astro";

const classificationIcons = [
  { icon: "/icon/indigenous.png", caption: "本源类" },
  { icon: "/icon/real.png", caption: "现实类" },
  { icon: "/icon/informational.png", caption: "信息类" },
];
---

<ArchiveLayout contentMode="custom">
  <ContentFrame iconItems={classificationIcons} iconFrameVariant="extended">
    <p>
      恶能的能力表现多种多样，不过依据科学，现代分类法通常将恶能分为三大类：本源类、现实类和信息类，各自有数个谱系，总共有10个谱系。
    </p>

    <p>
      <strong>【本源类】</strong>
    </p>
    <p>
      使用痕迹本身。暗就是痕迹本身，是痕迹最本质的形态。可以说暗=恶意=痕迹。
    </p>
    <div class="archive-table-wrap">
      <table class="archive-table is-lineage">
        <tbody>
          <tr>
            <th class="archive-table-row-label" scope="row">谱系本质</th>
            <td class="is-lineage-origin">痕迹</td>
            <td class="is-lineage-origin">翻转</td>
          </tr>
          <tr>
            <th class="archive-table-row-label" scope="row">通用称呼</th>
            <td class="is-lineage-origin">暗</td>
            <td class="is-lineage-origin">光</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p>
      <strong>【现实类】</strong>
    </p>
    <p>
      使用痕迹的能量，作用于物理世界。
    </p>
    <div class="archive-table-wrap">
      <table class="archive-table is-lineage">
        <tbody>
          <tr>
            <th class="archive-table-row-label" scope="row">谱系本质</th>
            <td class="is-lineage-reality">物质</td>
            <td class="is-lineage-reality">热能</td>
            <td class="is-lineage-reality">反应</td>
            <td class="is-lineage-reality">微场</td>
            <td class="is-lineage-reality">力势</td>
          </tr>
          <tr>
            <th class="archive-table-row-label" scope="row">通用称呼</th>
            <td class="is-lineage-reality">水</td>
            <td class="is-lineage-reality">冰</td>
            <td class="is-lineage-reality">火</td>
            <td class="is-lineage-reality">电</td>
            <td class="is-lineage-reality">风</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p>
      <strong>【信息类】</strong>
    </p>
    <p>
      使用痕迹的信息。
    </p>
    <div class="archive-table-wrap">
      <table class="archive-table is-lineage">
        <tbody>
          <tr>
            <th class="archive-table-row-label" scope="row">谱系本质</th>
            <td class="is-lineage-info">正信息</td>
            <td class="is-lineage-info">负信息</td>
            <td class="is-lineage-info">中信息</td>
          </tr>
          <tr>
            <th class="archive-table-row-label" scope="row">通用称呼</th>
            <td class="is-lineage-info">增幅</td>
            <td class="is-lineage-info">削弱</td>
            <td class="is-lineage-info">混乱</td>
          </tr>
        </tbody>
      </table>
    </div>
  </ContentFrame>
</ArchiveLayout>
