---
import ContentFrame from "../components/content-frame/ContentFrame.astro";
import ArchiveShellLayout from "./ArchiveShellLayout.astro";
import { getArchiveEntryContext } from "../data/archive/entryContext.js";

const {
  archive: archiveProp,
  ...archiveProps
} = Astro.props;

const archive = archiveProp ?? getArchiveEntryContext(Astro.url.pathname, archiveProps);
---

<ArchiveShellLayout
  archive={archive}
  defaultPage
  pageClass="secret-page"
  surfaceTone="secret"
  heroVariant="secret"
  scrollDecorVariant="secret"
  mobileSidebarIdPrefix="secret-mobile-page-nav"
>
  <ContentFrame variant="secret" nextPageLink={archive.nextPageLink} nextLinkMode="secret">
    <slot />
  </ContentFrame>
</ArchiveShellLayout>
