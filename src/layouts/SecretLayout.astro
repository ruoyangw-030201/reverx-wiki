---
import BaseLayout from "./BaseLayout.astro";
import Headbar from "../components/Headbar.astro";
import Endbar from "../components/Endbar.astro";
import ArchiveSidebar from "../components/ArchiveSidebar.astro";
import ArchiveEntryHeading from "../components/ArchiveEntryHeading.astro";
import ArchiveBackgroundLayer from "../components/archive/ArchiveBackgroundLayer.astro";
import ArchiveHero from "../components/archive/ArchiveHero.astro";
import ArchiveScrollDecor from "../components/archive/ArchiveScrollDecor.astro";
import ContentFrameBox from "../components/content-frame/ContentFrameBox.astro";
import "../styles/archive/layout.css";
import "../styles/content/content.css";
import "../styles/secret.css";
import {
  findNavigationItemByPath,
  getArchivePageNextLinkForPath,
  getSectionFromPath,
  topTabs,
} from "../data/navigation.js";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const currentSection = getSectionFromPath(currentPath);

const {
  title,
  subtitle,
} = Astro.props;

const navigationItem = findNavigationItemByPath(currentPath);
const sectionTab = topTabs.find((tab) => tab.key === currentSection);
const sectionKicker =
  currentSection === "characters" ? "FILES" : sectionTab?.labelEn ?? currentSection.toUpperCase();
const frameTitle = title ?? navigationItem?.label ?? "机密档案";
const frameSubtitle = subtitle ?? navigationItem?.labelEn ?? "classified file";
const nextPageLink = getArchivePageNextLinkForPath(currentPath);
---

<BaseLayout>
  <div class:list={["archive-page", "secret-page", `is-${currentSection}`]}>
    <ArchiveBackgroundLayer variant="secret" />

    <Headbar />

    <ArchiveHero variant="secret" />

    <ArchiveScrollDecor variant="secret" />

    <main class="archive-shell secret-shell">
      <ArchiveSidebar />

      <section class="archive-content-area secret-content-area">
        <ArchiveEntryHeading kicker={sectionKicker} title={frameTitle} subtitle={frameSubtitle} />

        <ContentFrameBox class="secret-text-box" variant="simple" tone="dark" minHeight="320px" nextPageLink={nextPageLink}>
          <slot />
        </ContentFrameBox>
      </section>
    </main>

    <Endbar />
  </div>
</BaseLayout>
