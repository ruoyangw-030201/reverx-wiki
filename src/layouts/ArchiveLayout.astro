---
import BaseLayout from "./BaseLayout.astro";
import ContentFrame from "../components/ContentFrame.astro";
import "../styles/archive.css";
import { topTabs, sidebarBySection } from "../data/navigation.js";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

function getCurrentSection(path) {
  if (path === "/system" || path.startsWith("/system/")) {
    return "system";
  }

  if (path === "/characters" || path.startsWith("/characters/")) {
    return "characters";
  }

  return "world";
}

const currentSection = getCurrentSection(currentPath);

const {
  sidebarTitle = "档案分类",
  sidebarTitleEn = "ARCHIVES",
  sidebarItems: sidebarItemsOverride,
} = Astro.props;

const sidebarItems =
  sidebarItemsOverride ?? sidebarBySection[currentSection] ?? sidebarBySection.world;

function isTopActive(href) {
  const normalized = href.replace(/\/$/, "");
  return currentPath === normalized || currentPath.startsWith(normalized + "/");
}

function isSideActive(href) {
  if (!href) return false;
  const normalized = href.replace(/\/$/, "") || "/";
  return currentPath === normalized;
}
---

<BaseLayout>
  <div class="archive-page">
    <div class="archive-bg-layer" aria-hidden="true">
      <img class="bg-texture bg-texture-1" src="/texture/texture-1.png" alt="" />
      <img class="bg-texture bg-texture-2" src="/texture/texture-2.png" alt="" />
      <img class="bg-texture bg-texture-3" src="/texture/texture-3.png" alt="" />
      <img class="bg-texture bg-texture-7" src="/texture/texture-7.png" alt="" />
      <img class="bg-texture bg-texture-9" src="/texture/texture-9.png" alt="" />

      <img class="bg-texture bg-gold-dot bg-gold-dot-1" src="/texture/texture-5.png" alt="" />
      <img class="bg-texture bg-gold-dot bg-gold-dot-2" src="/texture/texture-5.png" alt="" />
      <img class="bg-texture bg-gold-dot bg-gold-dot-3" src="/texture/texture-5.png" alt="" />

      <img class="bg-texture bg-blue-dot bg-blue-dot-left-1" src="/texture/texture-6.png" alt="" />
      <img class="bg-texture bg-blue-dot bg-blue-dot-left-2" src="/texture/texture-6.png" alt="" />

      <img class="bg-texture bg-blue-dot bg-blue-dot-right-1" src="/texture/texture-6.png" alt="" />
      <img class="bg-texture bg-blue-dot bg-blue-dot-right-2" src="/texture/texture-6.png" alt="" />
      <img class="bg-texture bg-blue-dot bg-blue-dot-right-3" src="/texture/texture-6.png" alt="" />
    </div>

    <header class="archive-headbar">
      <a class="archive-brand" href="/">
        <span class="archive-brand-mark" aria-hidden="true"></span>
        <span class="archive-brand-text">
          <span class="archive-brand-title">ReverX世界观快速入坑包</span>
          <span class="archive-brand-subtitle">ARCHIVES OF MALEVOLENT POWERS</span>
        </span>
      </a>

      <nav class="archive-topnav" aria-label="主导航">
        {topTabs.map((tab) => (
          <a
            class:list={[
              "archive-topnav-item",
              isTopActive(tab.href) && "is-active",
            ]}
            href={tab.href}
          >
            <span>{tab.label}</span>
            <small>{tab.labelEn}</small>
          </a>
        ))}
      </nav>

      <div class="archive-head-actions" aria-hidden="true">
        <span class="archive-search-icon"></span>
        <span class="archive-dot-grid"></span>
      </div>
    </header>

    <section class="archive-hero" aria-hidden="true">
      <img src="/bg/bg-big-4.png" alt="" />
    </section>

    <div class="archive-scroll-decor" aria-hidden="true">
      <img class="scroll-decor scroll-decor-big" src="/bg/bg-big-3.png" alt="" />
      <img class="scroll-decor scroll-decor-tri" src="/bg/bg-small-2.png" alt="" />
      <img class="scroll-decor scroll-decor-orb" src="/bg/bg-small-3.png" alt="" />
      <img class="scroll-decor scroll-decor-poly" src="/bg/bg-small-4.png" alt="" />
    </div>

    <main class="archive-shell">
      <aside class="archive-sidebar">
        <section class="archive-sidebar-nav">
          <div class="archive-sidebar-heading">
            <span>{sidebarTitle}</span>
            <small>{sidebarTitleEn}</small>
          </div>

          <nav aria-label="档案分类">
            {sidebarItems.map((item) => (
              item.type === "group" ? (
                item.href ? (
                  <a
                    class:list={[
                      "archive-sidebar-group",
                      isSideActive(item.href) && "is-active",
                    ]}
                    href={item.href}
                  >
                    {item.label}
                  </a>
                ) : (
                  <div class="archive-sidebar-group">
                    {item.label}
                  </div>
                )
              ) : (
                <a
                  class:list={[
                    "archive-sidebar-link",
                    item.depth === 1 && "is-depth-1",
                    isSideActive(item.href) && "is-active",
                  ]}
                   href={item.href}
                >
                  {item.icon && (
                    <img
                      class:list={[
                        "archive-sidebar-icon",
                        item.icon.startsWith("/icon/") && "is-small-source",
                      ]}
                      src={item.icon}
                      alt=""
                    />
                  )}
                  <span>{item.label}</span>
                </a>
              )
            ))}
          </nav>
        </section>
      </aside>

      <section class="archive-content-area">
        <ContentFrame>
          <slot />
        </ContentFrame>
      </section>
    </main>
  </div>
</BaseLayout>
