---
import BaseLayout from "./BaseLayout.astro";
import Headbar from "../components/Headbar.astro";
import ArchiveSidebar from "../components/ArchiveSidebar.astro";
import ArchiveEntryHeading from "../components/ArchiveEntryHeading.astro";
import ArchiveHeightSync from "../components/ArchiveHeightSync.astro";
import ContentFrame from "../components/content-frame/ContentFrame.astro";
import HomeCoverCanvas from "../components/HomeCoverCanvas.astro";
import "../styles/archive.css";
import "../styles/content.css";
import { findNavigationItemByPath, getSectionFromPath, topTabs } from "../data/navigation.js";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const currentSection = getSectionFromPath(currentPath);

const {
  title,
  subtitle,
  contentMode = "auto",
} = Astro.props;

const navigationItem = findNavigationItemByPath(currentPath);
const sectionTab = topTabs.find((tab) => tab.key === currentSection);
const sectionKicker =
  currentSection === "characters" ? "FILES" : sectionTab?.labelEn ?? currentSection.toUpperCase();
const frameTitle = title ?? navigationItem?.label ?? "世界简介";
const frameSubtitle = subtitle ?? navigationItem?.labelEn ?? "introduction";
const contentFrameIcon =
  currentSection === "characters"
    ? navigationItem?.frameIcon
    : currentSection === "world" || currentSection === "system"
      ? navigationItem?.icon
      : undefined;
const contentFrameIconCaption = currentSection === "system" ? navigationItem?.label : undefined;
const contentFrameIconVariant = currentSection === "characters" ? "figure" : "default";
---

<BaseLayout>
  <div class:list={["archive-page", `is-${currentSection}`]}>
    <div class="archive-bg-layer" aria-hidden="true">
      <img class="bg-texture bg-texture-1" src="/texture/texture-1.png" alt="" />
      <img class="bg-texture bg-texture-2" src="/texture/texture-2.png" alt="" />
      <img class="bg-texture bg-texture-3" src="/texture/texture-3.png" alt="" />
      <img class="bg-texture bg-texture-7" src="/texture/texture-7.png" alt="" />
      <img class="bg-texture bg-texture-9" src="/texture/texture-9.png" alt="" />

      <img class="bg-texture bg-gold-dot bg-gold-dot-1" src="/texture/texture-5.png" alt="" />
      <img class="bg-texture bg-gold-dot bg-gold-dot-2" src="/texture/texture-5.png" alt="" />
      <img class="bg-texture bg-gold-dot bg-gold-dot-3" src="/texture/texture-5.png" alt="" />

      <img class="bg-texture bg-blue-dot bg-blue-dot-left-1" src="/texture/texture-6.png" alt="" />
      <img class="bg-texture bg-blue-dot bg-blue-dot-left-2" src="/texture/texture-6.png" alt="" />

      <img class="bg-texture bg-blue-dot bg-blue-dot-right-1" src="/texture/texture-6.png" alt="" />
      <img class="bg-texture bg-blue-dot bg-blue-dot-right-2" src="/texture/texture-6.png" alt="" />
      <img class="bg-texture bg-blue-dot bg-blue-dot-right-3" src="/texture/texture-6.png" alt="" />
    </div>

    <Headbar />

    <section class="archive-hero" aria-hidden="true">
      <HomeCoverCanvas variant="static" />
    </section>

    <div class="archive-scroll-decor" aria-hidden="true">
      <img class="scroll-decor scroll-decor-big" src="/bg/bg-big-3.png" alt="" />
      <img class="scroll-decor scroll-decor-tri" src="/bg/bg-small-2.png" alt="" />
      <img class="scroll-decor scroll-decor-orb" src="/bg/bg-small-3.png" alt="" />
      <img class="scroll-decor scroll-decor-poly" src="/bg/bg-small-4.png" alt="" />
    </div>

    <main class="archive-shell">
      <ArchiveSidebar />

      <section class="archive-content-area">
        <ArchiveEntryHeading kicker={sectionKicker} title={frameTitle} subtitle={frameSubtitle} />

        {contentMode === "custom" ? (
          <slot />
        ) : (
          <ContentFrame
            icon={contentFrameIcon}
            iconAlt={frameTitle}
            iconCaption={contentFrameIconCaption}
            iconFrameVariant={contentFrameIconVariant}
          >
            <slot />
          </ContentFrame>
        )}
      </section>
    </main>

    <ArchiveHeightSync />
  </div>
</BaseLayout>
