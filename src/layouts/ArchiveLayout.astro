---
import BaseLayout from "./BaseLayout.astro";
import Headbar from "../components/Headbar.astro";
import Endbar from "../components/Endbar.astro";
import ArchiveSidebar from "../components/ArchiveSidebar.astro";
import ArchiveEntryHeading from "../components/ArchiveEntryHeading.astro";
import ArchiveHero from "../components/archive/ArchiveHero.astro";
import ArchiveScrollDecor from "../components/archive/ArchiveScrollDecor.astro";
import ContentFrame from "../components/content-frame/ContentFrame.astro";
import "../styles/archive/layout.css";
import "../styles/content/content.css";
import { findNavigationItemByPath, getSectionFromPath, topTabs } from "../data/navigation.js";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const currentSection = getSectionFromPath(currentPath);

const {
  title,
  subtitle,
  contentMode = "auto",
} = Astro.props;

const navigationItem = findNavigationItemByPath(currentPath);
const sectionTab = topTabs.find((tab) => tab.key === currentSection);
const sectionKicker =
  currentSection === "characters" ? "FILES" : sectionTab?.labelEn ?? currentSection.toUpperCase();
const frameTitle = title ?? navigationItem?.label ?? "世界简介";
const frameSubtitle = subtitle ?? navigationItem?.labelEn ?? "introduction";
const contentFrameIcon =
  currentSection === "characters"
    ? navigationItem?.frameIcon
    : currentSection === "world" || currentSection === "system"
      ? navigationItem?.icon
      : undefined;
const contentFrameIconCaption = currentSection === "system" ? navigationItem?.label : undefined;
const contentFrameIconVariant = currentSection === "characters" ? "figure" : "default";
---

<BaseLayout>
  <div class:list={["archive-page", `is-${currentSection}`]}>
    <Headbar />

    <ArchiveHero />

    <ArchiveScrollDecor />

    <main class="archive-shell">
      <ArchiveSidebar />

      <section class="archive-content-area">
        <ArchiveEntryHeading kicker={sectionKicker} title={frameTitle} subtitle={frameSubtitle} />

        {contentMode === "custom" ? (
          <slot />
        ) : (
          <ContentFrame
            icon={contentFrameIcon}
            iconAlt={frameTitle}
            iconCaption={contentFrameIconCaption}
            iconFrameVariant={contentFrameIconVariant}
          >
            <slot />
          </ContentFrame>
        )}
      </section>
    </main>

    <Endbar />
  </div>
</BaseLayout>
