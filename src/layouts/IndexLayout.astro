---
import BaseLayout from "./BaseLayout.astro";
import Headbar from "../components/Headbar.astro";
import ArchiveEntryHeading from "../components/ArchiveEntryHeading.astro";
import ArchiveBackgroundLayer from "../components/archive/ArchiveBackgroundLayer.astro";
import ContentFrameBox from "../components/content-frame/ContentFrameBox.astro";
import "../styles/archive/layout.css";
import "../styles/content/content.css";
import "../styles/index.css";
import { findNavigationItemByPath, getSectionFromPath, topTabs } from "../data/navigation.js";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const currentSection = getSectionFromPath(currentPath);

const {
  title,
  subtitle,
} = Astro.props;

const navigationItem = findNavigationItemByPath(currentPath);
const sectionTab = topTabs.find((tab) => tab.key === currentSection);
const sectionKicker = "INDEX";
const frameTitle = title ?? navigationItem?.label ?? sectionTab?.label ?? "档案";
const frameSubtitle = subtitle ?? navigationItem?.labelEn ?? sectionTab?.labelEn ?? "index";
---

<BaseLayout>
  <div class:list={["archive-page", "archive-index-page", `is-${currentSection}`]}>
    <ArchiveBackgroundLayer />

    <Headbar />

    <main class="archive-shell archive-index-shell">
      <section class="archive-content-area archive-index-content">
        <ArchiveEntryHeading kicker={sectionKicker} title={frameTitle} subtitle={frameSubtitle} />
        <ContentFrameBox class="archive-index-intro-box" variant="simple" tone="light" minHeight="118px">
          <slot name="intro" />
        </ContentFrameBox>
        <slot />
      </section>
    </main>
  </div>
</BaseLayout>
