---
import BaseLayout from "./BaseLayout.astro";
import ChromeHeadbar from "../components/chrome/ChromeHeadbar.astro";
import ActiveDirectionAction from "../components/ActiveDirectionAction.astro";
import NextPageTrigger from "../components/NextPageTrigger.astro";
import EntryHeading from "../components/primitives/EntryHeading.astro";
import BackgroundLayer from "../components/background/BackgroundLayer.astro";
import BackgroundSurface from "../components/background/BackgroundSurface.astro";
import ContentBox from "../components/content-frame/ContentBox.astro";
import "../styles/archive/layout.css";
import "../styles/index.css";
import {
  findNavigationItemByPath,
  getNextArchivePageForPath,
  getNextTopTabForPath,
  getSectionFromPath,
  topTabs,
} from "../data/navigation.js";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const currentSection = getSectionFromPath(currentPath);
const nextIndexTab = getNextTopTabForPath(currentPath);
const indexScrollNextPage =
  currentPath === "/world" || currentPath === "/system"
    ? getNextArchivePageForPath(currentPath)
    : null;

const {
  title,
  subtitle,
  number,
} = Astro.props;

const navigationItem = findNavigationItemByPath(currentPath);
const sectionTab = topTabs.find((tab) => tab.key === currentSection);
const sectionKicker = "INDEX";
const frameTitle = title ?? navigationItem?.label ?? sectionTab?.label ?? "档案";
const frameSubtitle = subtitle ?? navigationItem?.labelEn ?? sectionTab?.labelEn ?? "index";
const frameNumber = number ?? navigationItem?.number ?? sectionTab?.number ?? "00";
---

<BaseLayout>
  <div
    class:list={["archive-page", "archive-index-page", `is-${currentSection}`]}
    data-index-next-page={indexScrollNextPage?.href}
  >
    <BackgroundSurface tone="white" />

    <BackgroundLayer />

    <ChromeHeadbar />

    {
      indexScrollNextPage && (
        <ActiveDirectionAction
          direction="down"
          label="SCROLL"
          animated
          class="index-animate-marker index-page-arrow index-page-arrow--down"
          href={indexScrollNextPage.href}
          ariaLabel={`进入${indexScrollNextPage.label ?? indexScrollNextPage.labelEn ?? "下一页"}`}
        />
      )
    }

    {
      nextIndexTab && (
        <ActiveDirectionAction
          direction="right"
          animated
          class="index-animate-marker index-tab-arrow index-tab-arrow--next"
          href={nextIndexTab.href}
          ariaLabel={`进入${nextIndexTab.label}`}
        />
      )
    }

    <div class="index-fixed-crosshair" aria-hidden="true">
      <span class="index-fixed-line index-fixed-line-vertical"></span>
      <span class="index-fixed-line index-fixed-line-horizontal"></span>

      <div class="index-side-mark">
        <span class="index-side-mark-number-box">
        <span class="index-side-mark-number">{frameNumber}</span>
        </span>
        <span class="index-side-mark-slash"></span>
        <span class="index-side-mark-label">{frameSubtitle}</span>
      </div>
    </div>

    <main class="archive-shell archive-index-shell">
      <section class="archive-content-area archive-index-content">
        <div class="index-animate index-animate-heading-intro">
          <EntryHeading kicker={sectionKicker} title={frameTitle} subtitle={frameSubtitle} />

          <ContentBox class="archive-index-intro-box" variant="simple" minHeight="118px">
            <slot name="intro" />
          </ContentBox>
        </div>

        <div class="index-animate index-animate-grid">
          <slot />
        </div>
      </section>
    </main>

    {indexScrollNextPage && <NextPageTrigger nextHref={indexScrollNextPage.href} readyDelayMs={2020} disableBelowWidth={980} />}

  </div>
</BaseLayout>
