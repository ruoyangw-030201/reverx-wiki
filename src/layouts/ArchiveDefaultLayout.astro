---
import ContentFrame from "../components/content-frame/ContentFrame.astro";
import ArchiveShellLayout from "./ArchiveShellLayout.astro";
import { getArchiveEntryContext } from "../data/archiveEntryContext.js";

const {
  archive: archiveProp,
  ...archiveProps
} = Astro.props;

const archive = archiveProp ?? getArchiveEntryContext(Astro.url.pathname, archiveProps);
---

<ArchiveShellLayout archive={archive} defaultPage>
  <ContentFrame nextPageLink={archive.nextPageLink}>
    <slot />
  </ContentFrame>
</ArchiveShellLayout>
