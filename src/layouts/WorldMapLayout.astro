---
import ScrollDecor from "../components/background/ScrollDecor.astro";
import ActiveArrowButton from "../components/actions/ActiveArrowButton.astro";
import WorldMapCover from "../components/world-map/WorldMapCover.astro";
import WorldMapIntroPanel from "../components/world-map/WorldMapIntroPanel.astro";
import ChromeLayout from "./ChromeLayout.astro";
import "../styles/world-map/layout.css";
import { getArchivePageNextLinkForPath } from "../data/navigation.js";

const { mapConfig } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const nextPageLink = getArchivePageNextLinkForPath(currentPath);
---

<ChromeLayout
  pageClass={["archive-page", "world-map-page", "is-world"]}
  showHero={false}
  showEndbar={false}
  sidebarCollapseInactiveGroups
  sidebarIdPrefix="world-map-sidebar-desktop"
  mobileSidebarIdPrefix="world-map-mobile-page-nav"
>
  <ScrollDecor slot="decor" variant="worldMap" />

  <WorldMapIntroPanel mapConfig={mapConfig} nextPageLink={nextPageLink}>
    <slot />
  </WorldMapIntroPanel>

  <Fragment slot="after-stage">
    <div class="world-map-intro-marker-layer" aria-hidden="true">
      <ActiveArrowButton
        direction="down"
        label="滑动进入横屏交互地图"
        animated
        class="world-map-scroll-marker world-map-scroll-marker--desktop"
      />

      <ActiveArrowButton
        direction="up"
        label="滑动进入横屏交互地图"
        animated
        class="world-map-scroll-marker world-map-scroll-marker--mobile"
      />
    </div>

    <WorldMapCover mapConfig={mapConfig} />
  </Fragment>
</ChromeLayout>

<script>
  import "../scripts/worldMapPager.js";
</script>
