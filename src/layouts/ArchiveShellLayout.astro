---
import ChromeLayout from "./ChromeLayout.astro";
import EntryHeading from "../components/primitives/EntryHeading.astro";
import ScrollDecor from "../components/background/ScrollDecor.astro";
import ImageGallery from "../components/gallery/ImageGallery.astro";
import NextLinkButton from "../components/actions/NextLinkButton.astro";
import { getArchiveEntryContext } from "../data/archive/entryContext.js";

const {
  archive: archiveProp,
  pageClass,
  surfaceTone = "white",
  heroVariant,
  scrollDecorVariant,
  mobileSidebarIdPrefix = "chrome-archive-sidebar-mobile",
  showHeading = false,
  showStandaloneNextLink = false,
  ...archiveProps
} = Astro.props;

const archive = archiveProp ?? getArchiveEntryContext(Astro.url.pathname, archiveProps);
const pageClasses = Array.isArray(pageClass) ? pageClass : [pageClass];
---

<ChromeLayout
  pageClass={[
    "archive-page",
    `is-${archive.currentSection}`,
    ...pageClasses,
  ]}
  surfaceTone={surfaceTone}
  heroVariant={heroVariant ?? archive.currentSection}
  pageMode={archive.hasPageModeSwitch ? "normal" : undefined}
  mobileSidebarIdPrefix={mobileSidebarIdPrefix}
>
  <ScrollDecor slot="decor" variant={scrollDecorVariant} />

  {showHeading && (
    <EntryHeading
      kicker={archive.sectionKicker}
      title={archive.frameTitle}
      subtitle={archive.frameSubtitle}
    />
  )}

  <slot />

  {showStandaloneNextLink && archive.nextPageLink && (
    <NextLinkButton
      {...archive.nextPageLink}
      class="next-link-button-standalone"
    />
  )}

  {archive.characterGalleryId && (
    <ImageGallery
      slot="overlay"
      id={archive.characterGalleryId}
      images={archive.characterGalleryImages}
      label={archive.characterGalleryLabel}
    />
  )}
</ChromeLayout>
