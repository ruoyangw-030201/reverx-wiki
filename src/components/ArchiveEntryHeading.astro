---
import "../styles/archive-heading.css";

const {
  id,
  kicker,
  title,
  subtitle,
  variant = "primary",
  titleTag,
  yearSwitchLabel,
  yearSwitchCurrent,
  yearSwitchOptions = [],
} = Astro.props;

const HeadingTag = titleTag ?? (variant === "secondary" ? "h2" : "h1");
const isPrimary = variant === "primary";
const resolvedYearSwitchCurrent = yearSwitchCurrent ?? (
  yearSwitchLabel
    ? { label: yearSwitchLabel, mode: "normal" }
    : undefined
);
const rawYearSwitchOptions = Array.isArray(yearSwitchOptions) ? yearSwitchOptions : [];
const resolvedYearSwitchOptions = resolvedYearSwitchCurrent
  ? [
      ...(
        rawYearSwitchOptions.some((option) => option?.label === resolvedYearSwitchCurrent.label)
          ? []
          : [resolvedYearSwitchCurrent]
      ),
      ...rawYearSwitchOptions,
    ]
  : rawYearSwitchOptions;
const hasYearSwitch = Boolean(resolvedYearSwitchCurrent);
---

<header id={id} class:list={["archive-entry-heading", `is-${variant}`]}>
  {isPrimary && <span class="archive-entry-heading-kicker">{kicker}</span>}
  <div class="archive-entry-heading-title-row">
    <HeadingTag class="archive-entry-heading-title">{title}</HeadingTag>
    {hasYearSwitch && (
      <div class="archive-entry-year-menu" data-year-switch>
        <button
          class="archive-entry-year-switch"
          type="button"
          aria-label="切换设定年份"
          aria-haspopup="menu"
          aria-expanded="false"
          data-year-switch-trigger
          data-year-switch-default-label={resolvedYearSwitchCurrent.label}
          data-character-archive-target-mode={resolvedYearSwitchCurrent.mode ?? "normal"}
        >
          <span class="archive-entry-year-switch-label" data-year-switch-label>
            {resolvedYearSwitchCurrent.label}
          </span>
          <span class="archive-entry-year-switch-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
              <path d="M5.6 8.4a7.4 7.4 0 0 1 11.8-1.8" />
              <path d="M17.4 6.6h-3.5" />
              <path d="M17.4 6.6v-3.5" />
              <path d="M18.4 15.6a7.4 7.4 0 0 1-11.8 1.8" />
              <path d="M6.6 17.4h3.5" />
              <path d="M6.6 17.4v3.5" />
            </svg>
          </span>
        </button>

        {resolvedYearSwitchOptions.length > 0 && (
          <div class="archive-entry-year-dropdown" role="menu" hidden data-year-switch-menu>
            {resolvedYearSwitchOptions.map((option) => (
              <button
                class="archive-entry-year-option"
                type="button"
                role="menuitem"
                data-year-switch-option
                data-year-switch-option-label={option.label}
                data-character-archive-target-mode={option.mode ?? "normal"}
              >
                {option.label}
              </button>
            ))}
          </div>
        )}
      </div>
    )}
  </div>
  {subtitle && <p class="archive-entry-heading-subtitle">{subtitle}</p>}
</header>

{hasYearSwitch && (
  <script>
    const getCharacterArchivePage = () => document.querySelector(".archive-page.is-characters");

    const setCharacterArchiveMode = (mode = "normal") => {
      const page = getCharacterArchivePage();
      if (!page) return;

      page.setAttribute("data-character-archive-mode", mode);
      document.querySelectorAll("[data-character-archive-panel]").forEach((panel) => {
        const isActive = panel.getAttribute("data-character-archive-panel") === mode;
        panel.setAttribute("aria-hidden", String(!isActive));
      });
    };

    const closeYearMenu = (menuRoot) => {
      const trigger = menuRoot.querySelector("[data-year-switch-trigger]");
      const menu = menuRoot.querySelector("[data-year-switch-menu]");
      trigger?.setAttribute("aria-expanded", "false");
      menuRoot.classList.remove("is-open");
      if (menu) menu.hidden = true;
    };

    const closeAllYearMenus = () => {
      document.querySelectorAll("[data-year-switch]").forEach(closeYearMenu);
    };

    const updateYearMenuOptions = (menuRoot, currentLabel) => {
      menuRoot.querySelectorAll("[data-year-switch-option]").forEach((option) => {
        option.hidden = option.dataset.yearSwitchOptionLabel === currentLabel;
      });
    };

    const bindYearSwitches = () => {
      setCharacterArchiveMode("normal");
      closeAllYearMenus();

      document.querySelectorAll("[data-year-switch]").forEach((menuRoot) => {
        const trigger = menuRoot.querySelector("[data-year-switch-trigger]");
        const label = menuRoot.querySelector("[data-year-switch-label]");
        const menu = menuRoot.querySelector("[data-year-switch-menu]");

        if (label && trigger?.dataset.yearSwitchDefaultLabel) {
          label.textContent = trigger.dataset.yearSwitchDefaultLabel;
        }
        updateYearMenuOptions(menuRoot, label?.textContent?.trim());

        if (menuRoot.dataset.yearSwitchBound === "true") return;
        menuRoot.dataset.yearSwitchBound = "true";

        trigger?.addEventListener("click", (event) => {
          event.stopPropagation();
          const willOpen = trigger.getAttribute("aria-expanded") !== "true";
          closeAllYearMenus();
          trigger.setAttribute("aria-expanded", String(willOpen));
          menuRoot.classList.toggle("is-open", willOpen);
          if (menu) menu.hidden = !willOpen;
        });

        menuRoot.querySelectorAll("[data-year-switch-option]").forEach((option) => {
          option.addEventListener("click", (event) => {
            event.stopPropagation();
            const nextLabel = option.dataset.yearSwitchOptionLabel;
            const nextMode = option.dataset.characterArchiveTargetMode || "normal";
            if (label && nextLabel) label.textContent = nextLabel;
            setCharacterArchiveMode(nextMode);
            updateYearMenuOptions(menuRoot, nextLabel);
            closeYearMenu(menuRoot);
          });
        });
      });
    };

    if (!window.__archiveEntryYearSwitchBound) {
      window.__archiveEntryYearSwitchBound = true;
      document.addEventListener("click", closeAllYearMenus);
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeAllYearMenus();
      });
    }

    bindYearSwitches();
    document.addEventListener("astro:page-load", bindYearSwitches);
  </script>
)}
