---
import DirectionArrow from "../primitives/DirectionArrow.astro";
import "../../styles/gallery/image-gallery-arrow-button.css";

const {
  direction = "right",
} = Astro.props;

const isLeft = direction === "left";
const label = isLeft ? "上一张图片" : "下一张图片";
const dataAttr = isLeft ? { "data-gallery-prev": true } : { "data-gallery-next": true };
---

<button
  class:list={[
    "image-gallery-arrow",
    isLeft ? "image-gallery-arrow-left" : "image-gallery-arrow-right",
  ]}
  type="button"
  aria-label={label}
  {...dataAttr}
>
  <DirectionArrow direction={isLeft ? "left" : "right"} class="image-gallery-arrow-symbol" />
</button>
