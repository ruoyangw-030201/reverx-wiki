---
import ImageGalleryArrowButton from "./ImageGalleryArrowButton.astro";
import ImageGalleryControls from "./ImageGalleryControls.astro";
import ImageGalleryStage from "./ImageGalleryStage.astro";
import "../../styles/gallery/image-gallery.css";

const {
  id,
  images = [],
  label = "Image gallery",
} = Astro.props;

const galleryImages = Array.isArray(images)
  ? images.filter((image) => image?.src)
  : [];
const firstImage = galleryImages[0];
---

{id && firstImage && (
  <dialog
    class="image-gallery"
    id={id}
    aria-label={label}
    data-image-gallery
    data-gallery-images={JSON.stringify(galleryImages)}
  >
    <button class="image-gallery-backdrop" type="button" aria-label="关闭图片图集" tabindex="-1" data-gallery-close></button>

    <div class="image-gallery-main">
      <ImageGalleryControls caption={firstImage.caption} imageCount={galleryImages.length} />
      <ImageGalleryStage image={firstImage} />
    </div>

    <ImageGalleryArrowButton direction="left" />
    <ImageGalleryArrowButton direction="right" />

    <script>
      import "../../scripts/image-gallery.js";
    </script>
  </dialog>
)}
