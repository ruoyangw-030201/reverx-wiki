---
import EntryHeading from "../primitives/EntryHeading.astro";
import "../../styles/index/index-section.css";

const {
  title,
  subtitle,
  description,
  layout = "default",
} = Astro.props;

const descriptionText = description
  ? `${description.trim().replace(/[。！？.!?]+$/u, "")}。`
  : "";
---

<article class:list={["index-section", layout !== "default" && `is-${layout}`]}>
  <div class="index-section-heading-row">
    <EntryHeading variant="secondary" title={title} subtitle={subtitle} />
    {descriptionText && <p class="index-section-description">{descriptionText}</p>}
  </div>
  <div class="index-section-content">
    <slot />
  </div>
</article>