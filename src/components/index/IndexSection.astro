---
import ArchiveEntryHeading from "../ArchiveEntryHeading.astro";

const {
  title,
  subtitle,
  description,
  contentWidth = "100%",
} = Astro.props;

const descriptionText = description
  ? `${description.replace(/[。.!！?？\s]+$/u, "")}。`
  : "";
---

<article class="index-section" style={`--index-section-content-width: ${contentWidth};`}>
  <div class="index-section-heading-row">
    <ArchiveEntryHeading variant="secondary" title={title} subtitle={subtitle} />
    {descriptionText && <p class="index-section-description">{descriptionText}</p>}
  </div>
  <div class="index-section-content">
    <slot />
  </div>
</article>
