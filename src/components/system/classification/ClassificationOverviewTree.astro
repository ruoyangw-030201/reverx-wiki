---
import ClassificationOverviewConnector from "./ClassificationOverviewConnector.astro";
import ClassificationOverviewCard from "./ClassificationOverviewCard.astro";
import {
  classificationGroups,
  classificationOverviewRoot,
} from "../../../data/system/classification.js";
import "../../../styles/system/classification/classification-overview-tree.css";
---

<div class="classification-overview-tree" aria-label="恶能三大类别概览">
  <ClassificationOverviewConnector />

  <div class="classification-overview-item classification-overview-root">
    <ClassificationOverviewCard
      root
      theme="reality"
      icon={classificationOverviewRoot.icon}
      title={classificationOverviewRoot.title}
    />
  </div>

  {classificationGroups.map((group) => (
    <div class:list={["classification-overview-item", "classification-overview-node", `is-${group.id}`]}>
      <ClassificationOverviewCard
        theme={group.id}
        icon={group.icon}
        title={group.title}
      />
    </div>
  ))}
</div>
