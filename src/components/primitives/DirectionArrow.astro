---
import "../../styles/primitives/direction-arrow.css";

const {
  direction = "right",
  animated = false,
  class: className = "",
} = Astro.props;
---

<span
  class:list={[
    "direction-arrow",
    `is-${direction}`,
    animated && "is-animated",
    className,
  ]}
  aria-hidden="true"
></span>
