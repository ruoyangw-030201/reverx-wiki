---
import RefreshIcon from "../primitives/RefreshIcon.astro";
import "../../styles/actions/year-switch.css";

const {
  current,
  options = [],
  placement = "desktop",
} = Astro.props;

const rawOptions = Array.isArray(options) ? options : [];
const resolvedOptions = current
  ? [
      ...(
        rawOptions.some((option) => option?.label === current.label)
          ? []
          : [current]
      ),
      ...rawOptions,
    ]
  : rawOptions;
const hasPageMode = Boolean(current?.mode) || resolvedOptions.some((option) => Boolean(option?.mode));
---

{current && (
  <>
    <div class:list={["archive-entry-year-menu", `is-${placement}`]} data-year-switch>
      <button
        class="archive-entry-year-switch frame-decor is-gold refresh-icon-trigger"
        type="button"
        aria-label="切换设定年份"
        aria-haspopup="menu"
        aria-expanded="false"
        data-year-switch-trigger
        data-year-switch-default-label={current.label}
        data-page-target-mode={hasPageMode ? current.mode ?? "normal" : undefined}
      >
        <span class="archive-entry-year-switch-label" data-year-switch-label>
          {current.label}
        </span>
        <RefreshIcon class="archive-entry-year-switch-icon" />
      </button>

      {resolvedOptions.length > 0 && (
        <div class="archive-entry-year-dropdown" role="menu" hidden data-year-switch-menu>
          {resolvedOptions.map((option) => (
            <button
              class="archive-entry-year-option"
              type="button"
              role="menuitem"
              data-year-switch-option
              data-year-switch-option-label={option.label}
              data-page-target-mode={hasPageMode ? option.mode ?? "normal" : undefined}
            >
              {option.label}
            </button>
          ))}
        </div>
      )}
    </div>

    <script>
      const getPageModeRoot = () => document.querySelector(".chrome-page");

      const setPageMode = (mode) => {
        if (!mode) return;
        const page = getPageModeRoot();
        if (!page) return;

        page.setAttribute("data-page-mode", mode);
        document.querySelectorAll("[data-page-mode-panel]").forEach((panel) => {
          const isActive = panel.getAttribute("data-page-mode-panel") === mode;
          panel.setAttribute("aria-hidden", String(!isActive));
        });
        window.dispatchEvent(new CustomEvent("page-mode-change", {
          detail: { mode },
        }));
      };

      const closeYearMenu = (menuRoot) => {
        const trigger = menuRoot.querySelector("[data-year-switch-trigger]");
        const menu = menuRoot.querySelector("[data-year-switch-menu]");
        trigger?.setAttribute("aria-expanded", "false");
        menuRoot.classList.remove("is-open");
        if (menu) menu.hidden = true;
      };

      const closeAllYearMenus = () => {
        document.querySelectorAll("[data-year-switch]").forEach(closeYearMenu);
      };

      const updateYearMenuOptions = (menuRoot, currentLabel) => {
        menuRoot.querySelectorAll("[data-year-switch-option]").forEach((option) => {
          option.hidden = option.dataset.yearSwitchOptionLabel === currentLabel;
        });
      };

      const syncYearSwitchLabels = (nextLabel) => {
        document.querySelectorAll("[data-year-switch]").forEach((menuRoot) => {
          const label = menuRoot.querySelector("[data-year-switch-label]");
          if (label && nextLabel) label.textContent = nextLabel;
          updateYearMenuOptions(menuRoot, nextLabel);
        });
      };

      const bindYearSwitches = () => {
        closeAllYearMenus();

        document.querySelectorAll("[data-year-switch]").forEach((menuRoot) => {
          const trigger = menuRoot.querySelector("[data-year-switch-trigger]");
          const label = menuRoot.querySelector("[data-year-switch-label]");
          const menu = menuRoot.querySelector("[data-year-switch-menu]");

          if (label && trigger?.dataset.yearSwitchDefaultLabel) {
            label.textContent = trigger.dataset.yearSwitchDefaultLabel;
          }
          setPageMode(trigger?.dataset.pageTargetMode);
          updateYearMenuOptions(menuRoot, label?.textContent?.trim());

          if (menuRoot.dataset.yearSwitchBound === "true") return;
          menuRoot.dataset.yearSwitchBound = "true";

          trigger?.addEventListener("click", (event) => {
            event.stopPropagation();
            const willOpen = trigger.getAttribute("aria-expanded") !== "true";
            closeAllYearMenus();
            trigger.setAttribute("aria-expanded", String(willOpen));
            menuRoot.classList.toggle("is-open", willOpen);
            if (menu) menu.hidden = !willOpen;
          });

          menuRoot.querySelectorAll("[data-year-switch-option]").forEach((option) => {
            option.addEventListener("click", (event) => {
              event.stopPropagation();
              const nextLabel = option.dataset.yearSwitchOptionLabel;
              const nextMode = option.dataset.pageTargetMode;
              setPageMode(nextMode);
              syncYearSwitchLabels(nextLabel);
              closeYearMenu(menuRoot);
            });
          });
        });
      };

      if (!window.__archiveYearSwitchBound) {
        window.__archiveYearSwitchBound = true;
        document.addEventListener("click", closeAllYearMenus);
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") closeAllYearMenus();
        });
      }

      bindYearSwitches();
      document.addEventListener("astro:page-load", bindYearSwitches);
    </script>
  </>
)}
