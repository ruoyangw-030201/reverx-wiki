---
const {
  direction = "right",
  label,
  mobileLabel,
  class: className = "",
  href,
  ariaLabel,
  button = false,
} = Astro.props;

const markerClass = [
  "active-direction-marker",
  `active-direction-marker--${direction}`,
  className,
].filter(Boolean).join(" ");

const labelAttrs = {
  ...(label ? { "data-label": label } : {}),
  ...(mobileLabel ? { "data-mobile-label": mobileLabel } : {}),
};

const blades = [0, 1, 2, 3];
---

{
  button ? (
    <button class={markerClass} type="button" aria-label={ariaLabel ?? label} {...labelAttrs}>
      <span class="active-direction-marker__icon" aria-hidden="true">
        {blades.map(() => <span class="active-direction-marker__blade"></span>)}
      </span>
    </button>
  ) : href ? (
    <a class={markerClass} href={href} aria-label={ariaLabel} {...labelAttrs}>
      <span class="active-direction-marker__icon" aria-hidden="true">
        {blades.map(() => <span class="active-direction-marker__blade"></span>)}
      </span>
    </a>
  ) : (
    <div class={markerClass} aria-hidden="true" {...labelAttrs}>
      <span class="active-direction-marker__icon" aria-hidden="true">
        {blades.map(() => <span class="active-direction-marker__blade"></span>)}
      </span>
    </div>
  )
}
