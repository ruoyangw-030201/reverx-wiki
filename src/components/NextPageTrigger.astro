---
const {
  nextHref,
  readyDelayMs = 0,
  skipReadyDelayWhenHtmlClass,
} = Astro.props;

const resolvedReadyDelayMs = Math.max(0, Number(readyDelayMs) || 0);
---

{
  nextHref && (
    <span
      data-next-page-trigger
      data-next-href={nextHref}
      data-ready-delay-ms={resolvedReadyDelayMs}
      data-skip-ready-delay-when-html-class={skipReadyDelayWhenHtmlClass}
      hidden
    ></span>
  )
}

<script>
  import {
    isScrollNavigationLocked,
    setScrollNavigationLock,
  } from "../scripts/scrollNavigationGuard.js";

  const SCROLL_NAVIGATION_LOCK_MS = 900;

  function setupNextPageTrigger() {
    const trigger = document.querySelector("[data-next-page-trigger]");
    if (!(trigger instanceof HTMLElement)) return;
    if (trigger.dataset.nextPageTriggerReady === "true") return;

    const nextHref = trigger.dataset.nextHref;
    if (!nextHref) return;

    trigger.dataset.nextPageTriggerReady = "true";

    const readyDelayMs = Number(trigger.dataset.readyDelayMs) || 0;
    const skipReadyDelayClass = trigger.dataset.skipReadyDelayWhenHtmlClass;
    const shouldSkipReadyDelay =
      Boolean(skipReadyDelayClass) &&
      document.documentElement.classList.contains(skipReadyDelayClass);
    const readyAt = Date.now() + (shouldSkipReadyDelay ? 0 : readyDelayMs);

    let isPaging = false;
    let touchStartX = 0;
    let touchStartY = 0;
    let touchStarted = false;

    function isReady() {
      return Date.now() >= readyAt;
    }

    function shouldBlockInput() {
      return isScrollNavigationLocked() || !isReady();
    }

    function goNext() {
      if (isPaging) return;
      isPaging = true;
      setScrollNavigationLock(SCROLL_NAVIGATION_LOCK_MS);
      window.location.assign(nextHref);
    }

    function handleWheel(event) {
      if (Math.abs(event.deltaX) > Math.abs(event.deltaY)) return;
      if (event.deltaY <= 0) return;

      event.preventDefault();
      if (shouldBlockInput()) return;
      goNext();
    }

    function handleTouchStart(event) {
      const touch = event.touches[0];
      touchStartX = touch.clientX;
      touchStartY = touch.clientY;
      touchStarted = true;
    }

    function handleTouchEnd(event) {
      if (!touchStarted) return;
      touchStarted = false;

      const touch = event.changedTouches[0];
      const deltaX = touch.clientX - touchStartX;
      const deltaY = touch.clientY - touchStartY;

      if (Math.abs(deltaX) > Math.abs(deltaY) || Math.abs(deltaY) < 36) return;
      if (deltaY < 0) {
        event.preventDefault();
        if (shouldBlockInput()) return;
        goNext();
      }
    }

    function handleKeyDown(event) {
      if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
      if (event.key !== "PageDown" && event.key !== "ArrowDown") return;

      event.preventDefault();
      if (shouldBlockInput()) return;
      goNext();
    }

    window.addEventListener("wheel", handleWheel, { passive: false });
    window.addEventListener("touchstart", handleTouchStart, { passive: true });
    window.addEventListener("touchend", handleTouchEnd, { passive: false });
    window.addEventListener("keydown", handleKeyDown);
  }

  setupNextPageTrigger();
  document.addEventListener("astro:page-load", setupNextPageTrigger);
</script>
