    function readPxVariable(element, name, fallback) {
      const value = Number.parseFloat(window.getComputedStyle(element).getPropertyValue(name));
      return Number.isFinite(value) ? value : fallback;
    }

    function isVisibleBox(element) {
      const style = window.getComputedStyle(element);
      if (style.display === "none" || style.visibility === "hidden") return false;

      const rect = element.getBoundingClientRect();
      return rect.width > 0 || rect.height > 0;
    }

    function measurePage(page) {
      if (!(page instanceof HTMLElement)) return;

      if (page.matches(fixedPageSelector)) {
        page.style.removeProperty("--archive-page-measured-height");
        return;
      }

      const pageTop = page.getBoundingClientRect().top + window.scrollY;
      const bottomMargin = readPxVariable(page, "--archive-page-bottom-margin", 160);
      let contentBottom = pageTop;

      page.querySelectorAll(targetSelector).forEach((element) => {
        if (!(element instanceof Element) || !isVisibleBox(element)) return;

        const rect = element.getBoundingClientRect();
        contentBottom = Math.max(contentBottom, rect.bottom + window.scrollY);
      });

      const measuredHeight = Math.max(
        window.innerHeight,
        Math.ceil(contentBottom - pageTop + bottomMargin)
      );

      page.style.setProperty("--archive-page-measured-height", `${measuredHeight}px`);
    }

    function setupArchiveHeightSync() {
      const pages = Array.from(document.querySelectorAll(".archive-page"));
      if (!pages.length) return () => {};

      let frame = 0;

      const sync = () => {
        frame = 0;
        pages.forEach(measurePage);
      };

      const requestSync = () => {
        if (frame) return;
        frame = window.requestAnimationFrame(sync);
      };

      const watchedImages = [];
      pages.forEach((page) => {
        page.querySelectorAll("img").forEach((image) => {
          if (image.complete) return;

          image.addEventListener("load", requestSync, { once: true });
          image.addEventListener("error", requestSync, { once: true });
          watchedImages.push(image);
        });
      });

      const resizeObserver = "ResizeObserver" in window
        ? new ResizeObserver(requestSync)
        : null;

      if (resizeObserver) {
        pages.forEach((page) => {
          page.querySelectorAll(targetSelector).forEach((element) => {
            resizeObserver.observe(element);
          });
        });
      }

      window.addEventListener("resize", requestSync, { passive: true });
      document.fonts?.ready?.then(requestSync);
      requestSync();

      return () => {
        if (frame) {
          window.cancelAnimationFrame(frame);
        }

        window.removeEventListener("resize", requestSync);
        resizeObserver?.disconnect();
        watchedImages.forEach((image) => {
          image.removeEventListener("load", requestSync);
          image.removeEventListener("error", requestSync);
        });
      };
    }

    window[cleanupKey] = setupArchiveHeightSync();
    document.addEventListener("astro:page-load", () => {
      if (window[cleanupKey]) {
        window[cleanupKey]();
      }

      window[cleanupKey] = setupArchiveHeightSync();
    });
  })();
</script>
