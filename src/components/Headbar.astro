---
import "../styles/headbar.css";
import "../styles/active-marker.css";
import { topTabs } from "../data/navigation.js";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const menuId = "archive-topnav-menu";

function normalizeHref(href) {
  if (!href) return "";
  const [path] = href.split("#");
  return path.replace(/\/$/, "") || "/";
}

function isTopActive(href) {
  const normalized = normalizeHref(href);
  return currentPath === normalized || currentPath.startsWith(normalized + "/");
}
---

<header class="archive-headbar">
  <a class="archive-brand" href="/">
    <img class="archive-brand-icon" src="/big-icon/reverx.webp" alt="" aria-hidden="true" />
    <span class="archive-brand-text">
      <span class="archive-brand-title">世界观快速入坑包</span>
    </span>
  </a>

  <button
    class="archive-menu-toggle"
    type="button"
    aria-label="展开导航"
    aria-expanded="false"
    aria-controls={menuId}
    data-headbar-menu-toggle
  >
    <span class="archive-menu-toggle-bar"></span>
    <span class="archive-menu-toggle-bar"></span>
    <span class="archive-menu-toggle-bar"></span>
  </button>

  <nav class="archive-topnav" id={menuId} aria-label="主导航" data-headbar-menu>
    {topTabs.map((tab, index) => (
      <>
        {index > 0 && <span class="archive-topnav-divider" aria-hidden="true"></span>}
        <a
          class:list={[
            "archive-topnav-item",
            isTopActive(tab.href) && "is-active",
          ]}
          href={tab.href}
        >
          <span>{tab.label}</span>
          <small>{tab.labelEn}</small>
          <span class="archive-hourglass-marker" aria-hidden="true">
            <span class="archive-hourglass-body">
              <span class="archive-hourglass-line"></span>
              <span class="archive-hourglass-fill archive-hourglass-fill-top"></span>
              <span class="archive-hourglass-fill archive-hourglass-fill-bottom"></span>
            </span>
          </span>
        </a>
      </>
    ))}
  </nav>

  <div class="archive-head-actions" aria-hidden="true">
    <span class="archive-search-icon"></span>
    <span class="archive-dot-grid"></span>
  </div>
</header>

<script>
  const HEADBAR_MOBILE_QUERY = window.matchMedia("(max-width: 980px)");

  function initArchiveHeadbarMenus() {
    document.querySelectorAll(".archive-headbar").forEach((headbar) => {
      if (!(headbar instanceof HTMLElement) || headbar.dataset.headbarMenuReady === "true") return;

      const toggle = headbar.querySelector("[data-headbar-menu-toggle]");
      const menu = headbar.querySelector("[data-headbar-menu]");
      if (!(toggle instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;

      headbar.dataset.headbarMenuReady = "true";

      function closeMenu() {
        headbar.classList.remove("is-menu-open");
        toggle.setAttribute("aria-expanded", "false");
      }

      function openMenu() {
        headbar.classList.add("is-menu-open");
        toggle.setAttribute("aria-expanded", "true");
      }

      toggle.addEventListener("click", (event) => {
        if (!HEADBAR_MOBILE_QUERY.matches) return;
        event.stopPropagation();

        if (headbar.classList.contains("is-menu-open")) {
          closeMenu();
          return;
        }

        openMenu();
      });

      menu.addEventListener("click", (event) => {
        if (!HEADBAR_MOBILE_QUERY.matches) return;
        if (event.target instanceof Element && event.target.closest("a")) {
          closeMenu();
        }
      });

      document.addEventListener("click", (event) => {
        if (!HEADBAR_MOBILE_QUERY.matches || !headbar.classList.contains("is-menu-open")) return;
        if (event.target instanceof Node && headbar.contains(event.target)) return;
        closeMenu();
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeMenu();
      });

      HEADBAR_MOBILE_QUERY.addEventListener("change", closeMenu);
    });
  }

  initArchiveHeadbarMenus();
  document.addEventListener("astro:page-load", initArchiveHeadbarMenus);
</script>
