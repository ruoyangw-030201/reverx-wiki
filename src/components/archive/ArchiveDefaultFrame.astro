---
import ArchiveYearSwitch from "../ArchiveYearSwitch.astro";
import ContentFrame from "../content-frame/ContentFrame.astro";
import EntryHeading from "../primitives/EntryHeading.astro";
import "../../styles/archive/default-layout.css";
import "../../styles/content/content.css";

const {
  kicker,
  title,
  subtitle,
  yearSwitchCurrent,
  yearSwitchOptions,
  contentFrameIcon,
  contentFrameIconCaption,
  contentFrameIconVariant = "default",
  contentFrameGalleryId,
  nextPageLink,
} = Astro.props;

const hasYearSwitch = Boolean(yearSwitchCurrent);
---

<section class="archive-default-frame">
  {hasYearSwitch ? (
    <div class="archive-default-heading-cluster">
      <EntryHeading kicker={kicker} title={title} subtitle={subtitle} />
      <ArchiveYearSwitch
        current={yearSwitchCurrent}
        options={yearSwitchOptions}
        placement="desktop"
      />
    </div>
  ) : (
    <EntryHeading kicker={kicker} title={title} subtitle={subtitle} />
  )}

  <ContentFrame
    icon={contentFrameIcon}
    iconAlt={title}
    iconCaption={contentFrameIconCaption}
    iconFrameVariant={contentFrameIconVariant}
    iconFrameGalleryId={contentFrameGalleryId}
    iconFrameGalleryLabel={`${title} gallery`}
    iconFrameGalleryBadge="/icon/picture.png"
    nextPageLink={nextPageLink}
  >
    {hasYearSwitch && (
      <Fragment slot="mobile-before-body">
        <ArchiveYearSwitch
          current={yearSwitchCurrent}
          options={yearSwitchOptions}
          placement="mobile"
        />
      </Fragment>
    )}
    <slot />
  </ContentFrame>
</section>
