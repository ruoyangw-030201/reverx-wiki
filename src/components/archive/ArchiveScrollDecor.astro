---
import "../../styles/archive/decor.css";

const {
  variant = "default",
  class: className,
} = Astro.props;
---

<div
  class:list={[
    "archive-scroll-decor",
    variant === "secret" && "secret-scroll-decor",
    className,
  ]}
  aria-hidden="true"
>
  <img class="scroll-decor scroll-decor-big" src="/bg/bg-big-3.webp" alt="" />
  <img class="scroll-decor scroll-decor-small" src="/bg/bg-small-1-blue.webp" alt="" />
  <img class="scroll-decor scroll-decor-tri" src="/bg/bg-small-2.webp" alt="" />
  <img class="scroll-decor scroll-decor-orb" src="/bg/bg-small-3.webp" alt="" />
  <img class="scroll-decor scroll-decor-poly" src="/bg/bg-small-4.webp" alt="" />
</div>
