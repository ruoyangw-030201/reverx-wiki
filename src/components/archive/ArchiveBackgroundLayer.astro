---
import "../../styles/archive/decor.css";

const {
  variant = "default",
} = Astro.props;

const isSecret = variant === "secret";
---

<div class:list={["archive-bg-layer", isSecret && "secret-bg-layer"]} aria-hidden="true">
  {!isSecret && (
    <>
      <img class="bg-texture bg-texture-1" src="/bg/bg-big-1.png" alt="" />
      <img class="bg-texture bg-texture-3" src="/texture/texture-3.png" alt="" />
      <img class="bg-texture bg-texture-5" src="/texture/texture-5.png" alt="" />
      <img class="bg-texture bg-texture-7" src="/texture/texture-7.png" alt="" />

      <img class="bg-texture bg-gold-dot" src="/texture/texture-8.png" alt="" />
      <img class="bg-texture bg-small-5" src="/bg/bg-small-5.png" alt="" />
      <img class="bg-texture bg-small-6" src="/bg/bg-small-6.png" alt="" />
      <img class="bg-texture bg-small-7" src="/bg/bg-small-7.png" alt="" />
    </>
  )}
</div>
