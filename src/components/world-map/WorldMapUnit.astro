---
import RegionCard from "../actions/RegionCard.astro";
import "../../styles/world-map/world-map-unit.css";

const { mapConfig } = Astro.props;
const { width, height } = mapConfig.size;
const WORLD_MAP_LABEL_LEVELS = new Set(["state", "country"]);

function labelLevelClass(label) {
  const level = WORLD_MAP_LABEL_LEVELS.has(label.level) ? label.level : "state";
  return `world-map-label is-${level}`;
}

function hasClickableCityLabel(city) {
  return city.interactiveRegionKey && city.href;
}

function cityLabelX(city) {
  return city.x ?? city.markerX;
}

function cityLabelY(city) {
  return city.y ?? city.markerY;
}

function mobileCoordinate(value, offset, fallback) {
  if (Number.isFinite(value)) return value;
  if (Number.isFinite(offset)) return fallback + offset;
  return undefined;
}

function cityMobileLabelX(city) {
  return mobileCoordinate(city.mobileX, city.mobileLabelOffsetX, cityLabelX(city));
}

function cityMobileLabelY(city) {
  return mobileCoordinate(city.mobileY, city.mobileLabelOffsetY, cityLabelY(city));
}

const staticCities = mapConfig.cities.filter((city) => !hasClickableCityLabel(city));
const interactiveCities = mapConfig.cities.filter(hasClickableCityLabel);
const hintLabel = "点击地图白色区域可查看势力范围";
---

<div
  class="world-map-map-viewport"
  style={`--map-mobile-rotated-size: ${(width / height) * 100}vw;`}
>
  <div class="world-map-panel">
    <svg
      class="world-map-canvas"
      style={`--region-glow-filter: url(#world-map-region-glow-${mapConfig.key});`}
      viewBox={`0 0 ${width} ${height}`}
      width={width}
      height={height}
      preserveAspectRatio="xMidYMid meet"
      aria-label={`${mapConfig.title}势力区域`}
    >
      <defs>
        <filter id={`world-map-region-glow-${mapConfig.key}`} x="-8%" y="-8%" width="116%" height="116%">
          <feDropShadow dx="0" dy="0" stdDeviation="3" flood-color="var(--gold-light)" flood-opacity="0.72" />
          <feDropShadow dx="0" dy="0" stdDeviation="8" flood-color="var(--gold-main)" flood-opacity="0.34" />
        </filter>
      </defs>

      <image class="world-map-image" href={mapConfig.image} x="0" y="0" width={width} height={height} preserveAspectRatio="none" />

      <g class="world-map-region-layer">
        {mapConfig.regions.map((region) => (
          region.href ? (
            <a
              class="world-map-region is-clickable"
              href={region.href}
              aria-label={region.label}
              data-region-key={region.key}
              data-region-label={region.label}
              data-region-label-en={region.labelEn}
              data-region-icon={region.icon ?? "/icon/document.png"}
              data-card-x={region.cardX}
              data-card-y={region.cardY}
            >
              <title>{region.label}</title>
              <path class="world-map-region-shape" d={region.paths.join(" ")} fill-rule="evenodd" clip-rule="evenodd"></path>
            </a>
          ) : (
            <g
              class="world-map-region"
              aria-label={region.label}
              data-region-key={region.key}
              data-region-label={region.label}
              data-region-label-en={region.labelEn}
              data-region-icon={region.icon ?? "/icon/document.png"}
              data-card-x={region.cardX}
              data-card-y={region.cardY}
            >
              <title>{region.label}</title>
              <path class="world-map-region-shape" d={region.paths.join(" ")} fill-rule="evenodd" clip-rule="evenodd"></path>
            </g>
          )
        ))}
      </g>

      <g class="world-map-label-layer world-map-label-layer--static" aria-hidden="true">
        {mapConfig.labels.map((label) => (
          <text
            class:list={[labelLevelClass(label), "world-map-responsive-label"]}
            x={label.x}
            y={label.y}
            data-desktop-x={label.x}
            data-desktop-y={label.y}
            data-mobile-x={label.mobileX}
            data-mobile-y={label.mobileY}
          >
            {label.text}
          </text>
        ))}

        {staticCities.map((city) => (
          <>
            <circle class="world-map-city-marker" cx={city.markerX} cy={city.markerY} r="6" aria-hidden="true"></circle>
            <text
              class="world-map-label is-city world-map-responsive-label"
              x={cityLabelX(city)}
              y={cityLabelY(city)}
              data-desktop-x={cityLabelX(city)}
              data-desktop-y={cityLabelY(city)}
              data-mobile-x={cityMobileLabelX(city)}
              data-mobile-y={cityMobileLabelY(city)}
            >
              {city.text}
            </text>
          </>
        ))}
      </g>

      <g class="world-map-label-layer world-map-label-layer--interactive">
        {interactiveCities.map((city) => (
          <a
            class="world-map-city-link"
            href={city.href}
            aria-label={`查看${city.text}`}
            data-region-key={city.interactiveRegionKey}
          >
            <circle class="world-map-city-marker" cx={city.markerX} cy={city.markerY} r="6" aria-hidden="true"></circle>
            <text
              class="world-map-label is-city is-clickable world-map-responsive-label"
              x={cityLabelX(city)}
              y={cityLabelY(city)}
              data-desktop-x={cityLabelX(city)}
              data-desktop-y={cityLabelY(city)}
              data-mobile-x={cityMobileLabelX(city)}
              data-mobile-y={cityMobileLabelY(city)}
            >
              {city.text}
            </text>
          </a>
        ))}
      </g>

      <foreignObject class="world-map-region-card-foreign" x="0" y="0" width="520" height="150" aria-hidden="true">
        <RegionCard />
      </foreignObject>

      <text class="world-map-interaction-hint" x={width / 2} y={height - 42} aria-hidden="true">{hintLabel}</text>
    </svg>
  </div>
</div>

<script>
  import "../../scripts/worldMapUnit.js";
</script>
