---
import LeftDecor from "../primitives/LeftDecor.astro";
import RightDecor from "../primitives/RightDecor.astro";
import NextLinkButton from "../actions/NextLinkButton.astro";
import "../../styles/content-frame/content-frame.css";

const {
  variant,
  showLeftDecor = true,
  showRightDecor = true,
  nextPageLink,
  nextLinkMode,
} = Astro.props;

const isSecret = variant === "secret";
const showDecor = showLeftDecor || showRightDecor;
---

<div class:list={["content-frame", isSecret && "is-secret"]}>
  {showDecor && (
    <div class="content-frame-underlay-decor" aria-hidden="true">
      {showLeftDecor && <LeftDecor />}
      {showRightDecor && <RightDecor />}
    </div>
  )}

  <div class="content-frame-main">
    <div class="content-frame-sections">
      <slot />
      {nextPageLink && (
        <NextLinkButton
          {...nextPageLink}
          mode={nextLinkMode}
          class="content-frame-flow-next-link"
        />
      )}
    </div>
  </div>
</div>
