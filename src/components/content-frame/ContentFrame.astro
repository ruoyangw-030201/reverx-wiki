---
import ContentFrameBox from "./ContentFrameBox.astro";
import ContentFrameIconFrame from "./ContentFrameIconFrame.astro";
import ContentFrameLeftDecor from "./ContentFrameLeftDecor.astro";
import ContentFrameRightDecor from "./ContentFrameRightDecor.astro";

const {
  minHeight = "250px",
  showPaper = true,
  showLines = true,
  showLeftDecor = true,
  showRightDecor = true,
  showIconFrame = true,
  showJunction = true,
  icon,
  iconAlt = "",
  iconCaption,
  iconItems,
  iconFrameVariant = "default",
  iconFrameGalleryId,
  iconFrameGalleryLabel,
  iconFrameGalleryBadge,
  decorVisualHeight = "1000px",
  nextPageLink,
} = Astro.props;

const showDecor = showLeftDecor || showRightDecor;
const resolvedIconItems = Array.isArray(iconItems)
  ? iconItems
  : icon
    ? [{ icon, iconAlt, caption: iconCaption }]
    : [];
const hasIconFrameGallery = typeof iconFrameGalleryId === "string" && iconFrameGalleryId.length > 0;
---

<ContentFrameBox
  class:list={[
    showIconFrame && "has-icon-frame",
    showIconFrame && `is-icon-${iconFrameVariant}`,
  ]}
  minHeight={minHeight}
  decorVisualHeight={decorVisualHeight}
  showPaper={showPaper}
  showLines={showLines}
  extraFrameVars={showIconFrame ? `--content-frame-icon-count: ${resolvedIconItems.length};` : undefined}
  measureInteractive={hasIconFrameGallery}
  nextPageLink={nextPageLink}
>
  {showDecor && (
    <Fragment slot="decor-underlay">
      {showLeftDecor && <ContentFrameLeftDecor />}
      {showRightDecor && <ContentFrameRightDecor />}
    </Fragment>
  )}

  {showIconFrame && (
    <Fragment slot="measure">
      <ContentFrameIconFrame
        icon={icon}
        iconAlt={iconAlt}
        caption={iconCaption}
        items={iconItems}
        variant={iconFrameVariant}
        showJunction={showJunction}
        galleryId={iconFrameGalleryId}
        galleryLabel={iconFrameGalleryLabel}
        galleryBadge={iconFrameGalleryBadge}
      />
    </Fragment>
  )}

  <Fragment slot="mobile-before-body">
    <slot name="mobile-before-body" />
  </Fragment>

  <slot />
</ContentFrameBox>
