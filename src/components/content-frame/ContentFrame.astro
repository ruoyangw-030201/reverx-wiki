---
import ContentFrameBox from "./ContentFrameBox.astro";
import ContentFrameIconFrame from "./ContentFrameIconFrame.astro";
import ContentFrameJunction from "./ContentFrameJunction.astro";
import ContentFrameLeftDecor from "./ContentFrameLeftDecor.astro";
import ContentFrameRightDecor from "./ContentFrameRightDecor.astro";

const {
  minHeight = "250px",
  showPaper = true,
  showLines = true,
  showLeftDecor = true,
  showRightDecor = true,
  showIconFrame = true,
  showJunction = true,
  icon,
  iconAlt = "",
  iconCaption,
  iconItems,
  iconFrameVariant = "default",
  decorVisualHeight = "1000px",
} = Astro.props;

const showDecor = showLeftDecor || showRightDecor;
const resolvedIconItems = Array.isArray(iconItems)
  ? iconItems
  : icon
    ? [{ icon, iconAlt, caption: iconCaption }]
    : [];
const iconFrameTop = 34;
const iconFrameHeight =
  iconFrameVariant === "figure"
    ? 1000
    : iconFrameVariant === "extended"
      ? Math.max(352, 120 + resolvedIconItems.length * 132)
      : 352;
const iconMeasureHeight = showIconFrame ? `${iconFrameTop + iconFrameHeight}px` : undefined;
---

<ContentFrameBox
  minHeight={minHeight}
  measureHeight={iconMeasureHeight}
  decorVisualHeight={decorVisualHeight}
  showPaper={showPaper}
  showLines={showLines}
>
  {showDecor && (
    <Fragment slot="decor-underlay">
      {showLeftDecor && <ContentFrameLeftDecor />}
      {showRightDecor && <ContentFrameRightDecor />}
    </Fragment>
  )}

  {showIconFrame && (
    <Fragment slot="measure">
      <ContentFrameIconFrame
        icon={icon}
        iconAlt={iconAlt}
        caption={iconCaption}
        items={iconItems}
        variant={iconFrameVariant}
      />
    </Fragment>
  )}

  {showJunction && (
    <Fragment slot="decor">
      <ContentFrameJunction />
    </Fragment>
  )}

  <slot />
</ContentFrameBox>
