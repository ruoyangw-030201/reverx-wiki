---
import "../../styles/content-frame.css";

const {
  icon,
  iconAlt = "",
  caption,
  items,
  variant = "default",
} = Astro.props;

const iconItems = Array.isArray(items)
  ? items
  : icon
    ? [{ icon, iconAlt, caption }]
    : [];

const isExtended = variant === "extended";
const isFigure = variant === "figure";
const iconFrameHeight = isExtended
  ? `${Math.max(352, 120 + iconItems.length * 132)}px`
  : undefined;
---

<div
  class:list={[
    "content-frame-icon-stack",
    isExtended && "is-extended",
    isFigure && "is-figure",
  ]}
  style={iconFrameHeight ? `--content-frame-icon-stack-height: ${iconFrameHeight};` : undefined}
  aria-hidden="true"
>
  <span class="content-frame-icon-box content-frame-icon-box-main"></span>
  <span class="content-frame-icon-box content-frame-icon-box-inner"></span>
  {iconItems.length > 0 && (
    <span
      class:list={[
        "content-frame-icon-media",
        iconItems.length > 1 && "is-multiple",
        isFigure && "is-figure",
      ]}
    >
      {iconItems.map((item) => (
        <span class="content-frame-icon-item">
          <img class="content-frame-icon-image" src={item.icon} alt={item.iconAlt ?? ""} />
          {item.caption && <span class="content-frame-icon-caption">{item.caption}</span>}
        </span>
      ))}
    </span>
  )}
</div>
