---
import ArchiveSidebar from "./ArchiveSidebar.astro";

const {
  collapseInactiveGroups = false,
  idPrefix = "archive-mobile-page-nav",
} = Astro.props;
---

<details class="archive-mobile-page-nav">
  <summary class="archive-mobile-page-nav-summary">
    <span>页面导航</span>
    <small>CONTENT LIST</small>
  </summary>

  <div class="archive-mobile-page-nav-panel">
    <ArchiveSidebar collapseInactiveGroups={collapseInactiveGroups} idPrefix={idPrefix} />
  </div>
</details>
