---
import "../styles/sidebar.css";
import "../styles/active-marker.css";
import {
  getSectionFromPath,
  getSidebarAnchorsForPath,
  getSidebarItemsForPath,
  normalizeNavigationHref,
  topTabs,
} from "../data/navigation.js";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const { collapseInactiveGroups = false, idPrefix = "archive-sidebar-group" } = Astro.props;
const currentSection = getSectionFromPath(currentPath);
const items = getSidebarItemsForPath(currentPath);
const sectionTab = topTabs.find((tab) => tab.key === currentSection);
const title = "档案分类";
const titleEn = "CATEGORIES";
const collapsibleGroupKeys = new Set(["ferdona", "hespera"]);
const ariaLabel = "档案分类";

function isCollapsibleGroup(item) {
  return item.type === "group" && (collapsibleGroupKeys.has(item.entityKey) || !item.href);
}

function isSideActive(href) {
  if (!href) return false;
  if (href.includes("#")) return false;
  return currentPath === normalizeNavigationHref(href);
}

function normalizeAnchor(itemPath, anchor) {
  const href = anchor.href ?? `${itemPath}#${anchor.id}`;

  return {
    ...anchor,
    depth: 2,
    isAnchor: true,
    href,
  };
}

function withPageAnchors(sidebarItems) {
  return sidebarItems.flatMap((item) => {
    const itemPath = normalizeNavigationHref(item.href);
    if (item.type === "group" || !itemPath) {
      return [item];
    }

    const anchorsForItem = getSidebarAnchorsForPath(itemPath).map((anchor) =>
      normalizeAnchor(itemPath, anchor)
    );

    return anchorsForItem.length > 0 ? [item, ...anchorsForItem] : [item];
  });
}

function groupSidebarItems(sidebarItems) {
  const groupedItems = [];
  let currentCollapsibleGroup = null;

  sidebarItems.forEach((item) => {
    if (isCollapsibleGroup(item)) {
      currentCollapsibleGroup = {
        type: "collapsible-group",
        item,
        id: `${idPrefix}-${item.entityKey ?? groupedItems.length}`,
        children: [],
      };
      groupedItems.push(currentCollapsibleGroup);
      return;
    }

    if (item.type === "group") {
      currentCollapsibleGroup = null;
      groupedItems.push({
        type: "item",
        item,
      });
      return;
    }

    if (currentCollapsibleGroup) {
      currentCollapsibleGroup.children.push(item);
      return;
    }

    groupedItems.push({
      type: "item",
      item,
    });
  });

  return groupedItems;
}

const sidebarItems = withPageAnchors(items);
const groupedSidebarItems = groupSidebarItems(sidebarItems);

function isCollapsibleEntryActive(entry) {
  return isSideActive(entry.item.href) || entry.children.some((item) => isSideActive(item.href));
}

function isCollapsibleEntryExpanded(entry) {
  return !collapseInactiveGroups || isCollapsibleEntryActive(entry);
}
---

<aside class="archive-sidebar">
  <section class="archive-sidebar-nav">
    <div class="archive-sidebar-heading">
      <span>{title}</span>
      <small>{titleEn}</small>
    </div>

    <nav aria-label={ariaLabel}>
      {sectionTab && (
        <a class="archive-sidebar-section-link" href={sectionTab.href}>
          <span>{sectionTab.label}</span>
        </a>
      )}

      {groupedSidebarItems.map((entry) => (
        entry.type === "collapsible-group" ? (
          <div
            class:list={[
              "archive-sidebar-collapsible-group",
              !isCollapsibleEntryExpanded(entry) && "is-collapsed",
            ]}
            data-sidebar-group-key={entry.item.key ?? entry.item.entityKey}
            data-sidebar-collapsible
          >
            <div class="archive-sidebar-group-row">
              <button
                class="archive-sidebar-group-toggle"
                type="button"
                aria-expanded={String(isCollapsibleEntryExpanded(entry))}
                aria-controls={entry.id}
                aria-label={`折叠或展开${entry.item.label}`}
                data-sidebar-toggle
              ></button>
              {entry.item.href ? (
                <a
                  class:list={[
                    "archive-sidebar-group",
                    "archive-sidebar-group-label",
                    "is-clickable",
                    isSideActive(entry.item.href) && "is-active",
                  ]}
                  href={entry.item.href}
                >
                  {entry.item.label}
                  <span class="archive-hourglass-marker" aria-hidden="true">
                    <span class="archive-hourglass-body">
                      <span class="archive-hourglass-cap"></span>
                      <span class="archive-hourglass-line"></span>
                      <span class="archive-hourglass-fill archive-hourglass-fill-top"></span>
                      <span class="archive-hourglass-fill archive-hourglass-fill-bottom"></span>
                    </span>
                  </span>
                </a>
              ) : (
                <span class="archive-sidebar-group archive-sidebar-group-label">
                  {entry.item.label}
                </span>
              )}
            </div>

            <div
              class="archive-sidebar-group-children"
              id={entry.id}
              data-sidebar-group-children
              data-sidebar-group-key={entry.item.key ?? entry.item.entityKey}
              data-sidebar-children
              hidden={!isCollapsibleEntryExpanded(entry)}
            >
              {entry.children.map((item) => (
                <a
                  class:list={[
                    "archive-sidebar-link",
                    item.depth === 2 && "is-depth-2",
                    item.isAnchor && "is-anchor",
                    isSideActive(item.href) && "is-active",
                  ]}
                  href={item.href}
                  data-sidebar-link-path={normalizeNavigationHref(item.href)}
                  data-sidebar-original-group-key={entry.item.key ?? entry.item.entityKey}
                  data-sidebar-original-icon={item.icon}
                  data-sidebar-mode-overrides={item.modeSidebarOverrides ? JSON.stringify(item.modeSidebarOverrides) : undefined}
                  data-sidebar-anchor={item.isAnchor ? item.href : undefined}
                >
                  {item.icon && (
                    <img
                      class="archive-sidebar-icon"
                      src={item.icon}
                      data-sidebar-icon
                      alt=""
                    />
                  )}
                  <span class="archive-sidebar-label">{item.label}</span>
                  <span class="archive-hourglass-marker" aria-hidden="true">
                    <span class="archive-hourglass-body">
                      <span class="archive-hourglass-line"></span>
                      <span class="archive-hourglass-fill archive-hourglass-fill-top"></span>
                      <span class="archive-hourglass-fill archive-hourglass-fill-bottom"></span>
                    </span>
                  </span>
                </a>
              ))}
            </div>
          </div>
        ) : (
          entry.item.type === "group" ? (
            entry.item.href ? (
              <a
                class:list={[
                  "archive-sidebar-group",
                  "is-clickable",
                  isSideActive(entry.item.href) && "is-active",
                ]}
                href={entry.item.href}
              >
                {entry.item.label}
                <span class="archive-hourglass-marker" aria-hidden="true">
                  <span class="archive-hourglass-body">
                    <span class="archive-hourglass-cap"></span>
                    <span class="archive-hourglass-line"></span>
                    <span class="archive-hourglass-fill archive-hourglass-fill-top"></span>
                    <span class="archive-hourglass-fill archive-hourglass-fill-bottom"></span>
                  </span>
                </span>
              </a>
            ) : (
              <div class="archive-sidebar-group">
                {entry.item.label}
              </div>
            )
          ) : (
            <a
              class:list={[
                "archive-sidebar-link",
                entry.item.depth === 2 && "is-depth-2",
                entry.item.isAnchor && "is-anchor",
                isSideActive(entry.item.href) && "is-active",
              ]}
              href={entry.item.href}
              data-sidebar-link-path={normalizeNavigationHref(entry.item.href)}
              data-sidebar-original-icon={entry.item.icon}
              data-sidebar-mode-overrides={entry.item.modeSidebarOverrides ? JSON.stringify(entry.item.modeSidebarOverrides) : undefined}
              data-sidebar-anchor={entry.item.isAnchor ? entry.item.href : undefined}
            >
              {entry.item.icon && (
                <img
                  class="archive-sidebar-icon"
                  src={entry.item.icon}
                  data-sidebar-icon
                  alt=""
                />
              )}
              <span class="archive-sidebar-label">{entry.item.label}</span>
              <span class="archive-hourglass-marker" aria-hidden="true">
                <span class="archive-hourglass-body">
                  <span class="archive-hourglass-line"></span>
                  <span class="archive-hourglass-fill archive-hourglass-fill-top"></span>
                  <span class="archive-hourglass-fill archive-hourglass-fill-bottom"></span>
                </span>
              </span>
            </a>
          )
        )
      ))}
    </nav>
  </section>
</aside>

<script is:inline>
  (() => {
    const normalizePath = (path) => path.replace(/\/$/, "") || "/";

    const initSidebarCollapsibleGroups = () => {
      document.querySelectorAll("[data-sidebar-collapsible]").forEach((group) => {
        if (group.dataset.sidebarCollapsibleReady === "true") return;
        const toggle = group.querySelector("[data-sidebar-toggle]");
        const children = group.querySelector("[data-sidebar-children]");

        if (!(toggle instanceof HTMLButtonElement) || !(children instanceof HTMLElement)) return;
        group.dataset.sidebarCollapsibleReady = "true";

        toggle.addEventListener("click", () => {
          const isExpanded = toggle.getAttribute("aria-expanded") === "true";

          toggle.setAttribute("aria-expanded", String(!isExpanded));
          children.hidden = isExpanded;
          group.classList.toggle("is-collapsed", isExpanded);
        });
      });
    };

    const initSidebarAnchorState = () => {
      const currentPath = normalizePath(window.location.pathname);
      const anchorLinks = Array.from(document.querySelectorAll("[data-sidebar-anchor]"))
        .filter((link) => {
          const href = link.getAttribute("href");
          if (!href) return false;
          const url = new URL(href, window.location.origin);
          return normalizePath(url.pathname) === currentPath && Boolean(url.hash);
        });

      if (!anchorLinks.length) return;

      const linkById = new Map();
      const targets = [];

      anchorLinks.forEach((link) => {
        const url = new URL(link.getAttribute("href"), window.location.origin);
        const id = decodeURIComponent(url.hash.slice(1));
        const target = document.getElementById(id);
        if (!target) return;

        if (!linkById.has(id)) {
          linkById.set(id, []);
          targets.push(target);
        }
        linkById.get(id).push(link);
      });

      if (!targets.length) return;

      const setActiveAnchor = (id) => {
        anchorLinks.forEach((link) => link.classList.remove("is-anchor-active"));
        if (!id || !linkById.has(id)) return;
        linkById.get(id).forEach((link) => link.classList.add("is-anchor-active"));
      };

      const updateActiveAnchor = () => {
        const referenceY = window.innerHeight * 0.36;
        let activeTarget = null;

        targets.forEach((target, index) => {
          const rect = target.getBoundingClientRect();
          const nextTarget = targets[index + 1];
          const nextContent = target.nextElementSibling;
          const rangeBottom = nextTarget
            ? nextTarget.getBoundingClientRect().top
            : Math.max(
                rect.bottom,
                nextContent?.getBoundingClientRect().bottom ?? rect.bottom
              );

          if (rect.top <= referenceY && rangeBottom > referenceY) {
            activeTarget = target;
          }
        });

        setActiveAnchor(activeTarget?.id);
      };

      let ticking = false;
      const requestUpdate = () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(() => {
          ticking = false;
          updateActiveAnchor();
        });
      };

      window.addEventListener("scroll", requestUpdate, { passive: true });
      window.addEventListener("resize", requestUpdate);
      window.addEventListener("hashchange", requestUpdate);
      updateActiveAnchor();
    };

    const parseSidebarOverrides = (value) => {
      if (!value) return null;

      try {
        return JSON.parse(value);
      } catch {
        return null;
      }
    };

    const findSidebarGroupChildren = (sidebar, groupKey) => {
      if (!sidebar || !groupKey) return null;

      return Array.from(sidebar.querySelectorAll("[data-sidebar-group-children]"))
        .find((children) => children.dataset.sidebarGroupKey === groupKey) ?? null;
    };

    const expandSidebarGroupForChildren = (children) => {
      const group = children?.closest("[data-sidebar-collapsible]");
      if (!group) return;

      const toggle = group.querySelector("[data-sidebar-toggle]");
      group.classList.remove("is-collapsed");
      children.hidden = false;
      toggle?.setAttribute("aria-expanded", "true");
    };

    const applyCharacterSidebarMode = (mode = "normal") => {
      const currentPath = normalizePath(window.location.pathname);
      if (!currentPath.startsWith("/characters/")) return;

      document.querySelectorAll("[data-sidebar-link-path]").forEach((link) => {
        if (link.dataset.sidebarLinkPath !== currentPath) return;

        const overrides = parseSidebarOverrides(link.dataset.sidebarModeOverrides);
        if (!overrides) return;

        const modeOverride = overrides[mode] ?? {};
        const targetGroupKey = modeOverride.groupKey ?? link.dataset.sidebarOriginalGroupKey;
        const targetIcon = modeOverride.icon ?? link.dataset.sidebarOriginalIcon;
        const sidebar = link.closest(".archive-sidebar");
        const targetChildren = findSidebarGroupChildren(sidebar, targetGroupKey);

        if (targetChildren && link.parentElement !== targetChildren) {
          targetChildren.appendChild(link);
        }

        const icon = link.querySelector("[data-sidebar-icon]");
        if (icon && targetIcon) {
          icon.setAttribute("src", targetIcon);
        }

        expandSidebarGroupForChildren(targetChildren);
      });
    };

    const initCharacterSidebarModeOverrides = () => {
      applyCharacterSidebarMode(
        document.querySelector(".archive-page.is-characters")?.getAttribute("data-character-archive-mode") ?? "normal"
      );

      if (window.__archiveSidebarModeOverrideBound) return;
      window.__archiveSidebarModeOverrideBound = true;
      window.addEventListener("character-archive-mode-change", (event) => {
        applyCharacterSidebarMode(event.detail?.mode ?? "normal");
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => {
        initSidebarCollapsibleGroups();
        initSidebarAnchorState();
        initCharacterSidebarModeOverrides();
      }, { once: true });
    } else {
      initSidebarCollapsibleGroups();
      initSidebarAnchorState();
      initCharacterSidebarModeOverrides();
    }
  })();
</script>
