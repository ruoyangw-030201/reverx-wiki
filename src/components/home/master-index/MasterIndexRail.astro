---
import { masterIndexRail } from "../../../data/home/masterIndex.js";
import "../../../styles/home/master-index/master-index-rail.css";

const dots = Array.from({ length: masterIndexRail.dotCount });
---

<aside class="master-index-rail" aria-hidden="true">
  <span class="master-index-rail-label">{masterIndexRail.labelEn}</span>
  <span class="master-index-rail-line is-top"></span>
  <span class="master-index-rail-diamond"></span>
  <span class="master-index-rail-line is-bottom"></span>

  <span class="master-index-rail-emblem">
    <img class="master-index-rail-malice" src="/cluster/malice-ball.webp" alt="" />
    <img class="master-index-rail-vestige" src="/icon/vestige.png" alt="" />
  </span>

  <span class="master-index-rail-title">{masterIndexRail.title}</span>
  <span class="master-index-rail-motto">
    {masterIndexRail.mottoLines.map((line) => (
      <span>{line}</span>
    ))}
  </span>
  <span class="master-index-rail-dots">
    {dots.map(() => <span></span>)}
  </span>
</aside>

<div class="master-index-hint" aria-hidden="true">{masterIndexRail.hint}</div>
